{
  "name": "@lectorium/share-video",
  "version": "0.0.0",
  "private": true,
  "description": "Long-running container that renders short-form video reels. Pulls render jobs from public.tasks (postgres queue), cuts audio, transcribes via Whisper, force-aligns caller text, overlays on themed S3 background pack, appends bundled logo, uploads to S3.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "postinstall": "node scripts/copy-bundled-font.js",
    "render-local": "ts-node scripts/render-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@fontsource/noto-sans": "^5.2.10",
    "@napi-rs/canvas": "^0.1.80",
    "express": "^4.21.1",
    "fluent-ffmpeg": "^2.1.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.20.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "tar": "^7.5.11",
    "file-type": "^22.0.0"
  }
}
