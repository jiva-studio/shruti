# Caddy auto-acquires Let's Encrypt cert via HTTP-01 challenge for any
# hostname that resolves to this server's IP (including <ip>.sslip.io).
#
# DOMAIN comes from .env. For sslip.io: 159-69-12-34.sslip.io
# ACME_EMAIL goes to Let's Encrypt for renewal notices.

{
    email {$ACME_EMAIL}
    # Keep Caddy's own access logs minimal — chat app logs structured JSON.
    log {
        output stderr
        level WARN
    }
}

{$DOMAIN} {
    # Compress everything EXCEPT text/event-stream. Compression buffers
    # response chunks to fill its block size, which defeats SSE
    # streaming — the client sees nothing until the buffer flushes,
    # making the answer appear as one big drop instead of token-by-token.
    @compressible {
        not header Accept text/event-stream
        not header Content-Type text/event-stream
    }
    encode @compressible zstd gzip

    # SSE: disable response buffering so chunks reach the client immediately.
    reverse_proxy chat:8080 {
        flush_interval -1
        transport http {
            read_buffer 8192
        }
    }

    log {
        output stdout
        format json
    }
}
