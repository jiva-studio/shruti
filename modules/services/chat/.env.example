# ──────────────────────────────────────────────────────────────────────
# Lectorium chat backend — local dev environment
# Copy to .env and fill in. Production secrets live in `fly secrets`.
# ──────────────────────────────────────────────────────────────────────

# S3 source (read-only)
S3_BUCKET=akds-lectorium
S3_REGION=us-east-1
S3_ENDPOINT=                                        # leave empty for AWS S3; set for MinIO/Yandex S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Postgres
# Local dev: chat:chat works as-is.
# Prod: deploy.sh generates POSTGRES_PASSWORD on the server, this URL is
# rebuilt inside docker-compose.yml from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://chat:chat@postgres:5432/chat
POSTGRES_PASSWORD=chat

# ── LLM providers ──
# Selects which adapter the chat service instantiates at boot. Russia
# VPS deploys with `yandex` or `gigachat`; global stays on `openrouter`.
# Each branch fail-boots if its required env vars are missing (yandex /
# gigachat checks live in Settings; openrouter check lives in the
# adapter constructor).
LLM_PROVIDER=openrouter                             # openrouter | yandex | gigachat

# OpenRouter (global region)
OPENROUTER_API_KEY=sk-or-...

# YandexGPT 5 (Russia region). Folder id is always required; auth via
# Api-Key (simpler, long-lived) OR an IAM token refreshed by the host.
# YANDEX_GPT_FOLDER_ID=
# YANDEX_GPT_API_KEY=
# YANDEX_IAM_TOKEN=

# GigaChat (Sber, Russia region). OAuth2 client-credentials flow —
# scope picks PERS (personal/free), B2B, or CORP. CA path mounts the
# Russian Trusted Root certificate bundle (prod only).
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_PATH=/etc/ssl/certs/russian-trusted-root.pem

# Legacy (litellm-shim era; kept until Wave 9 cleanup):
# GIGACHAT_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

LLM_DEFAULT=openrouter/deepseek/deepseek-chat
LLM_FALLBACK=openrouter/anthropic/claude-3-haiku

# ── Embedder ──
# OpenAI-compatible providers (openrouter, openai) take a single model
# id. Yandex uses an asymmetric pair — set EMBED_MODEL to the document
# encoder (`text-search-doc/latest`) and EMBED_QUERY_MODEL to the
# query encoder (`text-search-query/latest`); both dims must match.
# GigaChat takes a single model id (e.g. `EmbeddingsGigaR`).
EMBED_PROVIDER=openrouter                           # openrouter | openai | yandex | gigachat
EMBED_MODEL=openai/text-embedding-3-small           # provider-specific id
EMBED_QUERY_MODEL=                                  # asymmetric pair (Yandex only)
EMBED_DIM=1536                                      # must match model output dim

# Yandex embedder credentials default to the LLM credentials when
# unset (same folder, same auth). Override only if running embeddings
# under a separate Yandex Cloud SA / folder.
# YANDEX_EMBED_API_KEY=
# YANDEX_EMBED_FOLDER_ID=

# GigaChat embedder shares the GIGACHAT_CLIENT_ID / SECRET / SCOPE /
# CA_PATH credentials with the LLM adapter — no separate envs needed.
# GIGACHAT_EMBED_API_KEY=                            # legacy; unused

# ── Indexer ──
CATALOG_DIR=/var/lib/chat
INDEXER_INTERVAL_HOURS=6
INDEXER_LANGS=ru,en
INDEXER_BOOTSTRAP_ON_START=true

# ── Abuse mitigation ──
APP_SHARED_TOKEN=dev-token
DEVICE_RATE_LIMIT_PER_DAY=50
IP_RATE_LIMIT_PER_DAY=200

# ── Server ──
PORT=8080
LOG_LEVEL=info                                      # debug | info | warning | error
SERVICE_VERSION=dev

# ── HTTPS / Caddy (prod only; deploy.sh injects these on the VPS) ──
# Auto-derived as <ip-dashed>.sslip.io if SERVER_IP is set.
DOMAIN=
ACME_EMAIL=advaita.krishna.das@gmail.com
