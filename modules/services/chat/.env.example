# ──────────────────────────────────────────────────────────────────────
# Shruti chat backend — local dev environment
# Copy to .env and fill in. Production secrets live in `fly secrets`.
# ──────────────────────────────────────────────────────────────────────

# S3 source (read-only)
S3_BUCKET=shruti-engine
S3_REGION=us-east-1
S3_ENDPOINT=                                        # leave empty for AWS S3; set for MinIO/Yandex S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Postgres
# Role/db is `shruti` (postgres init in docker-compose.yml). Running via
# the infra compose stack, DATABASE_URL is OVERRIDDEN from
# SHRUTI_POSTGRES_PASSWORD (infra/app/.env.dev) — this value only applies
# when you run chat standalone against your own postgres.
# Prod: deploy.sh generates POSTGRES_PASSWORD on the server.
DATABASE_URL=postgresql://shruti:shruti@postgres:5432/shruti
POSTGRES_PASSWORD=shruti

# ── LLM providers ──
# Single-provider deployment: the chat service ships only the OpenRouter
# adapter. RU traffic transits the global backend via the RU reverse
# proxy (see #728); there is no in-region LLM stack anymore.
LLM_PROVIDER=openrouter                             # openrouter

# OpenRouter (global region)
OPENROUTER_API_KEY=sk-or-...

# Optional direct provider creds — used by litellm when a model id
# matches a non-OpenRouter provider prefix.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

LLM_DEFAULT=openrouter/deepseek/deepseek-chat
LLM_FALLBACK=openrouter/anthropic/claude-3-haiku

# ── Embedder ──
# OpenAI-compatible providers (openrouter, openai) take a single model id.
EMBED_PROVIDER=openrouter                           # openrouter | openai
EMBED_MODEL=openai/text-embedding-3-small           # provider-specific id
EMBED_QUERY_MODEL=                                  # reserved for asymmetric providers
EMBED_DIM=1536                                      # must match model output dim

# Per-model input prefixes for instruction-tuned embedders. Empty for
# OpenAI text-embedding-3-* and bge-m3 (prefix-free). For the e5 family
# (multilingual-e5-base/large/small, e5-mistral) set both (mind the
# trailing space — use quotes to preserve it):
#   EMBED_QUERY_PREFIX="query: "
#   EMBED_DOC_PREFIX="passage: "
# Both paths (indexer + live query) read the same setting, so swapping
# embedder model is a pure env change — no code edit required.
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=

# Bounded parallelism for LLM / embedding provider calls.
# EMBED_CONCURRENCY=2
# LLM_CONCURRENCY=2

# ── Indexer ──
CATALOG_DIR=/var/lib/chat
# Fractional values allowed: 0.25 = every 15 min (effective interval floored at 60s).
INDEXER_INTERVAL_HOURS=6
INDEXER_LANGS=ru,en
INDEXER_BOOTSTRAP_ON_START=true

# ── Abuse mitigation ──
APP_SHARED_TOKEN=dev-token
# Per-IP daily cap, anonymous-only (signed-in users are bottled by the
# per-user cap keyed on quota_id). Code default is 2000 — uncomment to
# override. Old releases had DEVICE_RATE_LIMIT_PER_DAY and a tighter
# IP_RATE_LIMIT_PER_DAY=200 here; both are gone, the per-IP cap now
# only applies to anonymous JWTs and the edge Caddy carries the raw
# DoS shield at 1000/hour/IP.
# IP_RATE_LIMIT_PER_DAY=2000

# ── Server ──
PORT=8080
LOG_LEVEL=info                                      # debug | info | warning | error
SERVICE_VERSION=dev

# ── HTTPS / Caddy (prod only; deploy.sh injects these on the VPS) ──
# Auto-derived as <ip-dashed>.sslip.io if SERVER_IP is set.
DOMAIN=
ACME_EMAIL=advaita.krishna.das@gmail.com

# ── Load & failure knobs ──
# All have working code defaults; they are listed so an operator can find and
# tune them during an incident without a rebuild. Uncommented values below are
# the defaults.
#
# Postgres pool. `FANOUT_DB_CONCURRENCY` caps how many ANN lanes ONE research
# turn may run at once — it and DB_POOL_MAX_SIZE are only meaningful together
# (unbounded, a single turn asks for ~60 connections). DB_COMMAND_TIMEOUT_S
# bounds query EXECUTION, not the wait for a free connection: asyncpg has no
# pool-level acquire timeout, which is why the fanout gate is what keeps the
# queue short.
# DB_POOL_MIN_SIZE=5
# DB_POOL_MAX_SIZE=50
# DB_COMMAND_TIMEOUT_S=15.0
# FANOUT_DB_CONCURRENCY=8
#
# Redis clients (cache, rate limit, idempotency, turn store). The op timeout is
# deliberately tight — a slow Redis must degrade, not hold the turn. The cache
# breaker opens after N consecutive failures; L1 keeps serving meanwhile.
# REDIS_OP_TIMEOUT_S=0.2
# CACHE_CIRCUIT_THRESHOLD=3
# CACHE_CIRCUIT_OPEN_S=30.0
#
# Turn admission. The daily caps bound volume, not concurrency; these bound
# concurrency and per-turn wall-clock. Over the ceiling /chat answers 503 with
# Retry-After and refunds the charge. 0 disables either bound.
# MAX_IN_FLIGHT_TURNS=24
# TURN_BUDGET_S=300.0
#
# Turn buffer (resume). `running` is the heartbeat-refreshed liveness window —
# once it lapses a reconnecting client reads the turn as orphaned; `result` is
# how long a finished answer stays fetchable; `cancel` is the cross-replica
# Stop flag. CANCEL_POLL_INTERVAL_S is how often a running turn re-reads that
# flag; the in-process event is checked every time regardless, so on a
# single-replica deploy this only bounds a Stop routed elsewhere.
# TURN_RUNNING_TTL_S=180
# TURN_RESULT_TTL_S=86400
# TURN_CANCEL_TTL_S=180
# CANCEL_POLL_INTERVAL_S=1.0
#
# Reranker. The concurrency limit is PROCESS-WIDE, shared by every turn — not a
# per-turn budget. The breaker stops an outage costing a full timeout on every
# rerank of every turn (call sites already fall back to cosine ordering).
# RERANK_CONCURRENCY=8
# RERANK_TIMEOUT_S=10.0
# RERANK_CIRCUIT_THRESHOLD=3
# RERANK_CIRCUIT_OPEN_S=30.0
#
# LiteLLM path (/title, /questions, proactive turns). These bypass the
# LLMPort adapter and its own 180s cap, and LiteLLM defaults to no timeout.
# LLM_ONESHOT_TIMEOUT_S=20.0
# LLM_STREAM_TIMEOUT_S=180.0
#
# Indexer. Concurrent transcript workers per run; each holds a pool connection
# and an embedding call, and the indexer shares both with live traffic.
# INDEXER_CONCURRENCY=8
