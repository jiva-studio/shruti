{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "paths": {
      "@ports/*":              ["./ports/*"],
      "@infra/*":              ["./infra/*"],
      "@ui/*":                 ["./ui/*"],
      "@lectorium/*":          ["./lectorium/*"],
      "@lib/domain":           ["./submodules/domain/index.ts"],
      "@lib/domain/*":         ["./submodules/domain/*"],
      "@lib/application":      ["./submodules/application/index.ts"],
      "@lib/application/*":    ["./submodules/application/*"],
      "@lib/persistence/main": ["./submodules/persistence-main/index.ts"],
      "@lib/persistence/user": ["./submodules/persistence-user/index.ts"],
      "@docs/*":               ["./submodules/docs/*"],
      "@kit/core":             ["../../kit/src/core/index.ts"],
      "@kit/*":                ["../../kit/src/*"],
      "vue":                   ["./node_modules/vue"],
      "vue/*":                 ["./node_modules/vue/*"]
    }
  },
  "include": [
    "ports/**/*.ts",
    "infra/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.vue",
    "lectorium/**/*.ts",
    "lectorium/**/*.vue",
    "submodules/domain/**/*.ts",
    "submodules/application/**/*.ts",
    "submodules/persistence-main/**/*.ts",
    "submodules/persistence-user/**/*.ts",
    "../../kit/src/**/*.ts",
    "../../kit/src/**/*.vue",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "submodules/dal",
    "submodules/protocol",
    "src",
    "dist",
    "android",
    "ios",
    "../../kit/src/**/__tests__/**"
  ]
}
