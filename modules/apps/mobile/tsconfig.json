{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@blocks/*":             ["./src/blocks/*"],
      "@lectorium/mobile/*":   ["./src/*"],
      "@lectorium/dal":        ["./submodules/dal"],
      "@lectorium/protocol/*": ["./submodules/protocol/*"],
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "submodules/**/*"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
