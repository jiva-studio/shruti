{
  "name": "lectorium-mobile",
  "private": true,
  "version": "0.9.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build+sync": "npm run build && npx cap sync",
    "preview": "vite preview",
