    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/vue": "^8.8.3",
    "@ionic/vue-router": "^8.8.3",
    "@lectorium/plugin-audio-player": "file:../../plugins/audio-player",
    "@lectorium/plugin-media-downloader": "file:../../plugins/media-downloader",
    "@tabler/icons-vue": "^3.44.0",
