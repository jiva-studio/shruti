{
  "name": "shruti-mobile",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "versionCodeOffset": 2000,
  "scripts": {
    "dev": "vite",
    "dev:screenshots": "VITE_DEBUG_API=true vite --port 11001",
    "build": "vue-tsc && vite build",
    "build+sync": "npm run build && npx cap sync",
    "preview": "vite preview",
    "lint": "eslint . submodules/chat submodules/contracts submodules/domain submodules/persistence-main submodules/persistence-user submodules/ui",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "locales:sr-cyrl": "node ../../tools/sr-transliterate/generate-sr-cyrl.mjs",
    "locales:sr-cyrl:check": "npm run locales:sr-cyrl && { drift=$(git status --porcelain -- shruti/i18n/locales/sr-Cyrl); test -z \"$drift\" || { echo \"$drift\"; git --no-pager diff -- shruti/i18n/locales/sr-Cyrl; exit 1; }; }",
    "assets:generate": "npx --yes @capacitor/assets generate"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.22",
    "@ionic/vue": "^8.8.3",
    "@ionic/vue-router": "^8.8.3",
    "@shruti/plugin-audio-player": "file:../../plugins/audio-player",
    "@shruti/plugin-media-downloader": "file:../../plugins/media-downloader",
    "@revenuecat/purchases-capacitor": "^13.1.1",
    "@sentry/capacitor": "^4.1.0",
    "@sentry/vue": "10.52.0",
    "@tabler/icons-vue": "^3.44.0",
    "@vueuse/core": "^14.3.0",
    "capacitor-plugin-safe-area": "^5.0.0",
    "marked": "^18.0.3",
    "nanoid": "^5.1.9",
    "pinia": "^3.0.2",
    "sql.js": "^1.14.1",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6",
    "vue3-radial-progress": "^1.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/language-server": "^3.0.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "terser": "^5.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.7"
  },
  "description": "Shruti"
}
