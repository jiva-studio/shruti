  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/language-server": "^3.0.5",
    "eslint": "^10.3.0",
