fastlane_version "2.228.0"

require "base64"
require "fileutils"
require "json"
require "tmpdir"
require_relative "lib/release_notes"

# Project root = modules/apps/mobile (parent of fastlane/)
MOBILE_ROOT = File.expand_path("..", __dir__)

# Marketing version — single source of truth lives in package.json.
def mobile_version
  @mobile_version ||= JSON.parse(File.read(File.join(MOBILE_ROOT, "package.json"))).fetch("version")
end

# Offset keeps the per-workflow GITHUB_RUN_NUMBER above already-shipped builds.
# Single source of truth lives in package.json (`versionCodeOffset`) so the web
# build (vite.config.ts) applies the same offset to the build id shown in
# Settings — keeping the displayed build id equal to the store versionCode.
def version_code_offset
  @version_code_offset ||=
    JSON.parse(File.read(File.join(MOBILE_ROOT, "package.json"))).fetch("versionCodeOffset", 0)
end

# Store build number — always $GITHUB_RUN_NUMBER (+ offset) in CI,
# empty locally. Store-upload lanes enforce presence via
# require_ci_build_id!.
def ci_build_id
  raw = ENV["GITHUB_RUN_NUMBER"].to_s.strip
  return "" if raw.empty?
  (raw.to_i + version_code_offset).to_s
end

# ---------------------------------------------------------------------------- #
# Store locale registry — the single source of truth for which locales we
# publish and how each maps to the two stores. Mirrored on the TS side by
# modules/tools/screenshots/config.ts (both read store-locales.json). Adding a
# language to the stores is one entry there; the lanes below derive everything
# from it. Schema: see store-locales.json `$comment`.
# ---------------------------------------------------------------------------- #
def store_locales
  @store_locales ||=
    JSON.parse(File.read(File.join(MOBILE_ROOT, "store-locales.json"))).fetch("locales")
end

# App UI locales we generate screenshots for (capture != false).
def capture_locales
  store_locales.select { |_, v| v.fetch("capture", true) }.keys
end

# { app_locale => Google Play code } for entries published on Play.
# `only` filters to a requested subset of app locales.
def play_locale_map(only: nil)
  store_locales.each_with_object({}) do |(loc, v), h|
    next if v["play"].nil?
    next if only && !only.include?(loc)
    h[loc] = v["play"]
  end
end

# { app_locale => App Store Connect code } for entries the App Store supports
# (appStore == null is skipped — e.g. Serbian, which the store can't take).
def app_store_locale_map(only: nil)
  store_locales.each_with_object({}) do |(loc, v), h|
    next if v["appStore"].nil?
    next if only && !only.include?(loc)
    h[loc] = v["appStore"]
  end
end

# Parse a lane's `locales:` option ("en,ru") into an array, or default to the
# full capture set from the registry.
def requested_locales(options)
  return capture_locales if options[:locales].to_s.strip.empty?
  options[:locales].split(",").map(&:strip)
end

# ---------------------------------------------------------------------------- #
# Shared setup (runs before every lane on both platforms)
# ---------------------------------------------------------------------------- #

before_all do |lane|
  # Upload-only and screenshot lanes don't build anything — skip web/cap/db
  # setup entirely. (deploy-* runners have neither node nor native SDKs.)
  next if lane == :upload
  next if lane == :screenshots

  platform_flag = lane_context[SharedValues::PLATFORM_NAME].to_s
  next if platform_flag.empty?

  # Web bundle — provided as artifact in CI, built locally on demand.
  unless File.exist?(File.join(MOBILE_ROOT, "dist", "index.html"))
    sh("cd #{MOBILE_ROOT.shellescape} && npm ci && npm run build")
  end

  # Sync Capacitor — copies web bundle into native project.
  sh("cd #{MOBILE_ROOT.shellescape} && npx cap sync #{platform_flag}")

  # Keep the iOS Google Sign-In config (GIDClientID + reversed-client-id URL
  # scheme) in Info.plist matched to whatever iOS client id the web bundle was
  # built with. No-op unless SHRUTI_GOOGLE_IOS_CLIENT_ID overrides the
  # committed default. cap sync doesn't touch Info.plist, so this is safe after.
  if platform_flag == "ios"
    sh("bash #{File.join(MOBILE_ROOT, 'scripts/ios-google-signin.sh').shellescape}")
  end

  # Bundle production DB into native app assets. Must run after sync,
  # which may clean the assets directory. The shared db-sync script
  # (modules/db-sync.sh) reads the supported scheme from the single
  # source of truth (modules/db-scheme.json) and distributes the latest
  # compatible DB to the per-platform path.
  if %w[android ios].include?(platform_flag)
    # MOBILE_ROOT = modules/apps/mobile → ../../.. is the repo root.
    repo_root = File.expand_path("../../..", MOBILE_ROOT)
    sh("bash #{File.join(repo_root, 'modules/db-sync.sh').shellescape} #{platform_flag}")
  end
end

# ---------------------------------------------------------------------------- #
platform :android do
  desc "Debug APK (unsigned)"
  lane :build_debug do
    gradle(
      project_dir: File.join(MOBILE_ROOT, "android"),
      task: "assembleDebug",
      properties: version_properties,
    )
  end

  desc "Signed release APK"
  lane :build_release do
    setup_keystore
    gradle(
      project_dir: File.join(MOBILE_ROOT, "android"),
      task: "assembleRelease",
      properties: version_properties.merge(signing_properties),
    )
  end

  desc "Signed release AAB + upload to Google Play internal"
  lane :deploy do
    require_ci_build_id!
    setup_keystore
    gradle(
      project_dir: File.join(MOBILE_ROOT, "android"),
      task: "bundleRelease",
      properties: version_properties.merge(signing_properties),
    )
    upload_to_play_store(**play_store_upload_params)
  end

  desc "Debug APK + signed release AAB in one gradle invocation"
  lane :build_all do
    setup_keystore
    gradle(
      project_dir: File.join(MOBILE_ROOT, "android"),
      tasks: ["assembleDebug", "bundleRelease"],
      properties: version_properties.merge(signing_properties),
    )
  end

  desc "Upload existing signed AAB to Google Play (no rebuild). Pass track:internal|alpha|beta|production (default internal)."
  lane :upload do |options|
    require_ci_build_id!
    aab = options[:aab] || File.join(MOBILE_ROOT, "android/app/build/outputs/bundle/release/app-release.aab")
    UI.user_error!("AAB not found at #{aab}") unless File.exist?(aab)
    upload_to_play_store(**play_store_upload_params(aab: aab, track: options[:track]))
  end

  desc "Regenerate fixtures, capture screenshots via Playwright, upload to Google Play"
  lane :screenshots do |options|
    screenshots_tool = File.expand_path("../../tools/screenshots", MOBILE_ROOT)
    metadata_root = File.join(__dir__, "metadata/android")

    # app_locale => Play code, for the requested (or all-capture) locales that
    # are actually published on Play.
    locale_map = play_locale_map(only: requested_locales(options))
    locales = locale_map.keys
    # First iteration: phone-only. tablet7 / tablet10 projects don't exist in
    # `modules/tools/screenshots/playwright.config.ts` yet — when they're
    # added, extend this map and the `project_flags` line below.
    device_map = {
      "phone" => "phoneScreenshots",
    }
    project_flags = locales.map { |l| "--project=phone-#{l}" }.join(" ")

    # 1. Regenerate deterministic user fixtures (one per locale).
    unless options[:skip_generate]
      sh("cd #{screenshots_tool.shellescape} && npm install --no-audit --no-fund")
      locales.each do |loc|
        sh("cd #{screenshots_tool.shellescape} && npm run generate-user-fixture -- --locale=#{loc}")
      end
    end

    # 2. Capture screenshots via Playwright (filtered by --project flags).
    unless options[:skip_capture]
      sh("cd #{screenshots_tool.shellescape} && npx playwright test specs/capture.spec.ts #{project_flags}")
    end

    # 3. Wrap raw PNGs into marketing frames (title + device silhouette).
    unless options[:skip_frame]
      sh("cd #{screenshots_tool.shellescape} && npx playwright test specs/frame.spec.ts #{project_flags}")
    end

    # 4. Lay out framed PNGs where `supply` expects them.
    #   out/framed/phone-<loc>/*.png    → images/phoneScreenshots/
    #   out/framed/tablet7-<loc>/*.png → images/sevenInchScreenshots/
    locale_map.each do |src_lang, play_locale|
      device_map.each do |device, play_dir|
        src = File.join(screenshots_tool, "out/framed/#{device}-#{src_lang}")
        next unless Dir.exist?(src)
        dst = File.join(metadata_root, play_locale, "images/#{play_dir}")
        FileUtils.mkdir_p(dst)
        FileUtils.rm_f(Dir.glob(File.join(dst, "*.png")))
        Dir.glob(File.join(src, "*.png")).each do |png|
          FileUtils.cp(png, dst)
        end
        UI.message("Staged #{Dir.glob(File.join(dst, '*.png')).size} screenshots → #{dst}")
      end
    end

    # Supply scans every locale under metadata/android/ and tries to upload
    # images found there. Wipe screenshot dirs for locales not in this run so
    # stale PNGs (or locales without a Play Console listing yet) don't block
    # the upload with "no title for language X" errors.
    selected_play_locales = locale_map.values
    Dir.glob(File.join(metadata_root, "*")).each do |loc_dir|
      next unless File.directory?(loc_dir)
      next if selected_play_locales.include?(File.basename(loc_dir))
      device_map.each_value do |play_dir|
        stale = File.join(loc_dir, "images", play_dir)
        FileUtils.rm_rf(stale) if Dir.exist?(stale)
      end
    end

    # 5. Upload only screenshots to Play (skip everything else).
    next if options[:skip_upload]
    play_params = {
      track: "internal",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false,
      # Commit the edit, but do NOT auto-submit for review. User submits via
      # Play Console UI after visually confirming the staged set.
      changes_not_sent_for_review: true,
      validate_only: options[:dry_run] ? true : false,
    }
    # supply attaches screenshots to a specific release identified by
    # version_code. The screenshots workflow is standalone (not chained
    # after deploy-android), so GITHUB_RUN_NUMBER doesn't correspond to
    # any release in Play Console — Play would respond with
    # "Could not find release for version code '<N>'". Resolve the
    # current internal version_code from Play Console at runtime and
    # use it.
    version_codes = google_play_track_version_codes(
      package_name: "studio.jiva.shruti",
      track: "internal",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
    )
    if version_codes.empty?
      UI.user_error!("No releases on the Play Console internal track — upload an AAB first")
    end
    play_params[:version_code] = version_codes.max.to_i
    UI.message("Attaching screenshots to internal track version_code=#{play_params[:version_code]}")
    upload_to_play_store(**play_params)
  end

  desc "Upload Google Play listing copy (titles/descriptions) from metadata/android/. " \
       "Gated: commits the edit but does NOT submit for review. Pass dry_run:true to validate only."
  lane :metadata do |options|
    # supply uploads every locale dir present under metadata_path/android. We
    # only commit complete listings (see store-locales.json `canonical` +
    # translate-store-copy), so there's nothing partial to blank out a listing.
    #
    # Even though listing copy is global (not per-release), supply ties the edit
    # to the track's release and can't choose when the internal track has more
    # than one ("More than one release found in this track"). Resolve the
    # current internal version_code at runtime, exactly like the screenshots
    # lane does.
    version_codes = google_play_track_version_codes(
      package_name: "studio.jiva.shruti",
      track: "internal",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
    )
    UI.user_error!("No releases on the Play Console internal track — upload an AAB first") if version_codes.empty?
    upload_to_play_store(
      track: "internal",
      version_code: version_codes.max.to_i,
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      metadata_path: PLAY_METADATA_PATH,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      # Commit the edit, but leave submission to the user in the Play Console.
      changes_not_sent_for_review: true,
      validate_only: options[:dry_run] ? true : false,
    )
  end

  # ---- private ----

  private_lane :setup_keystore do
    UI.user_error!("KEYSTORE_BASE64 env var is required") if ENV["KEYSTORE_BASE64"].to_s.empty?
    path = File.join(MOBILE_ROOT, "android/app/keystore/release.jks")
    FileUtils.mkdir_p(File.dirname(path))
    File.binwrite(path, Base64.decode64(ENV["KEYSTORE_BASE64"]))
    ENV["KEYSTORE_PATH"] = path
    UI.message("Keystore decoded (#{File.size(path)} bytes)")
  end

  def version_properties
    props = { "versionName" => mobile_version }
    props["versionCode"] = ci_build_id unless ci_build_id.empty?
    props
  end

  def signing_properties
    {
      "android.injected.signing.store.file"     => ENV["KEYSTORE_PATH"],
      "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"].to_s.strip,
      "android.injected.signing.key.alias"      => ENV["KEY_ALIAS"].to_s.strip,
      "android.injected.signing.key.password"   => ENV["KEY_PASSWORD"].to_s.strip,
    }
  end

  # Absolute path: fastlane chdirs into actions with a different CWD than the
  # lane body, so a `__dir__`-based relative path resolves differently for
  # `write_play_changelog_files!` (writes from fastlane/) and for `supply`
  # (reads from MOBILE_ROOT after fastlane's `Dir.chdir("..")`).
  PLAY_METADATA_PATH = File.join(MOBILE_ROOT, "fastlane/metadata/android")

  VALID_PLAY_TRACKS = %w[internal alpha beta production].freeze

  def play_store_upload_params(aab: nil, track: nil)
    track = "internal" if track.to_s.strip.empty?
    UI.user_error!("Unknown Play track '#{track}' (expected: #{VALID_PLAY_TRACKS.join(', ')})") unless VALID_PLAY_TRACKS.include?(track)
    # `supply` doesn't accept inline release notes — it reads them from
    # metadata/android/<locale>/changelogs/<version_code>.txt. Generate
    # per-locale notes via ReleaseNotes (LLM-curated, with raw fallback)
    # and stage the files before upload.
    write_play_changelog_files!
    {
      track: track,
      aab: aab || File.join(MOBILE_ROOT, "android/app/build/outputs/bundle/release/app-release.aab"),
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      release_status: "draft", # Required while the app itself is in draft in Play Console
      # Play Console "release name" — supply calls this version_name. Without
      # it, supply keeps whatever name the existing draft on the track already
      # has, so the label stays stuck at an old value even as new AABs land.
      version_name: mobile_version,
      metadata_path: PLAY_METADATA_PATH,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
    }
  end

  def write_play_changelog_files!
    build_id = ci_build_id
    return if build_id.empty?
    play_locales = play_locale_map.values
    notes = ReleaseNotes.generate(locales: play_locales)
    play_locales.each do |locale|
      dir = File.join(PLAY_METADATA_PATH, locale, "changelogs")
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "#{build_id}.txt"), notes.fetch(locale))
    end
  end
end

# ---------------------------------------------------------------------------- #
platform :ios do
  IOS_PROJECT_DIR = File.join(MOBILE_ROOT, "ios/App")
  IOS_WORKSPACE = File.join(IOS_PROJECT_DIR, "App.xcworkspace")
  IOS_XCODEPROJ = File.join(IOS_PROJECT_DIR, "App.xcodeproj")
  IOS_BUNDLE_ID = "studio.jiva.shruti"
  IOS_SCHEME = "App"
  IOS_PROVISIONING_PROFILE_NAME = "Shruti Distribution"
  IOS_IPA_PATH = File.join(MOBILE_ROOT, "ios/App/build/App.ipa")
  # App Store listing copy (name/subtitle/description/keywords). Kept in its own
  # tree — deliver scans metadata_path for locale subdirs and would choke on the
  # `android` folder if pointed at the shared metadata/ root.
  IOS_METADATA_PATH = File.join(MOBILE_ROOT, "fastlane/metadata/ios")

  desc "Build a signed App Store IPA"
  lane :build do
    setup_ios_keychain
    import_ios_certificates
    install_ios_provisioning_profiles

    update_code_signing_settings(
      path: IOS_XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_STORE_TEAM_ID"),
      bundle_identifier: IOS_BUNDLE_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: IOS_PROVISIONING_PROFILE_NAME,
      targets: ["App"],
      build_configurations: ["Release"],
    )

    increment_version_number(version_number: mobile_version, xcodeproj: IOS_XCODEPROJ)
    unless ci_build_id.empty?
      increment_build_number(build_number: ci_build_id, xcodeproj: IOS_XCODEPROJ)
    end

    build_app(
      project: IOS_XCODEPROJ,
      scheme: IOS_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(IOS_PROJECT_DIR, "build"),
      output_name: "App",
      clean: true,
      # Pipe raw xcodebuild output straight to stdout. xcpretty (the gym
      # default) hides codesign / link errors — when the archive fails on
      # CI we need the full text in the GitHub Actions log to diagnose
      # without ssh-ing into the self-hosted runner.
      xcodebuild_formatter: "",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_STORE_TEAM_ID"),
        provisioningProfiles: {
          IOS_BUNDLE_ID => IOS_PROVISIONING_PROFILE_NAME,
        },
      },
    )
  end

  desc "Upload existing IPA to TestFlight (no rebuild)"
  lane :upload do |options|
    require_ci_build_id!
    ipa = options[:ipa] || IOS_IPA_PATH
    UI.user_error!("IPA not found at #{ipa}") unless File.exist?(ipa)

    setup_app_store_connect_api_key

    pilot(
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ReleaseNotes.generate(locales: %w[en-US]).fetch("en-US"),
      beta_app_review_info: {
        contact_email: ENV["BETA_FEEDBACK_EMAIL"].to_s,
        contact_first_name: ENV["BETA_CONTACT_FIRST_NAME"].to_s,
        contact_last_name: ENV["BETA_CONTACT_LAST_NAME"].to_s,
        contact_phone: ENV["BETA_CONTACT_PHONE_NUMBER"].to_s,
        notes: "Automated TestFlight build",
      },
    )
  end

  desc "Regenerate fixtures, capture iOS screenshots via Playwright, upload to App Store Connect"
  lane :screenshots do |options|
    screenshots_tool = File.expand_path("../../tools/screenshots", MOBILE_ROOT)
    # Outside fastlane/metadata/ on purpose: deliver scans metadata_path for
    # locale subdirs and chokes on a non-locale 'ios' folder. Keep iOS
    # screenshots in their own tree.
    metadata_root = File.join(__dir__, "ios-screenshots")

    # app_locale => App Store code, for the requested (or all-capture) locales
    # the App Store actually supports. Serbian (appStore:null) is dropped here,
    # so it never gets captured or staged for iOS.
    locale_map = app_store_locale_map(only: requested_locales(options))
    locales = locale_map.keys
    devices = %w[iphone67 ipad13]
    project_flags = locales.flat_map { |l|
      devices.map { |d| "--project=#{d}-#{l}" }
    }.join(" ")

    unless options[:skip_generate]
      sh("cd #{screenshots_tool.shellescape} && npm install --no-audit --no-fund")
      locales.each do |loc|
        sh("cd #{screenshots_tool.shellescape} && npm run generate-user-fixture -- --locale=#{loc}")
      end
    end

    unless options[:skip_capture]
      sh("cd #{screenshots_tool.shellescape} && npx playwright test specs/capture.spec.ts #{project_flags}")
    end

    unless options[:skip_frame]
      sh("cd #{screenshots_tool.shellescape} && npx playwright test specs/frame.spec.ts #{project_flags}")
    end

    # Stage framed screenshots directly under fastlane/ios-screenshots/<locale>/.
    # Deliver only scans the locale folder itself (no subdirs), and detects the
    # device from pixel dimensions — so a flat per-locale layout works.
    # Prefix filenames with the device id to avoid name collisions between
    # iphone67/01_home.png and ipad13/01_home.png.
    locale_map.each do |src_lang, app_store_locale|
      dst = File.join(metadata_root, app_store_locale)
      FileUtils.mkdir_p(dst)
      FileUtils.rm_f(Dir.glob(File.join(dst, "*.png")))
      devices.each do |device|
        src = File.join(screenshots_tool, "out/framed/#{device}-#{src_lang}")
        next unless Dir.exist?(src)
        Dir.glob(File.join(src, "*.png")).each do |png|
          FileUtils.cp(png, File.join(dst, "#{device}-#{File.basename(png)}"))
        end
      end
      UI.message("Staged #{Dir.glob(File.join(dst, '*.png')).size} iOS screenshots → #{dst}")
    end

    # Strip screenshots for locales not included in this run so deliver
    # doesn't try to upload stale PNGs for locales without a listing.
    selected_locales = locale_map.values
    Dir.glob(File.join(metadata_root, "*")).each do |loc_dir|
      next unless File.directory?(loc_dir)
      next if selected_locales.include?(File.basename(loc_dir))
      FileUtils.rm_f(Dir.glob(File.join(loc_dir, "*.png")))
    end

    next if options[:skip_upload]

    setup_app_store_connect_api_key

    deliver(
      app_identifier: IOS_BUNDLE_ID,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      screenshots_path: File.expand_path(metadata_root),
      # Even with skip_metadata, deliver validates the locale directory names
      # under metadata_path (default ./fastlane/metadata) and rejects our
      # `android`/`ios` listing-copy subdirs. Point it at the ios subtree so it
      # only sees valid App Store locale dirs (en-US, ru).
      metadata_path: File.expand_path(IOS_METADATA_PATH),
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      # Don't auto-publish: user reviews staged set in App Store Connect before submitting.
      automatic_release: false,
    )
  end

  desc "Upload App Store listing copy (name/subtitle/description/keywords) from " \
       "metadata/ios/. Gated: does NOT submit for review. Serbian and other " \
       "App-Store-unsupported locales are simply absent from metadata/ios/."
  lane :metadata do
    setup_app_store_connect_api_key
    deliver(
      app_identifier: IOS_BUNDLE_ID,
      metadata_path: File.expand_path(IOS_METADATA_PATH),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false,
      # Skip the interactive HTML preview/confirmation — this lane is run
      # deliberately and the user reviews the result in App Store Connect.
      force: true,
    )
  end

  # ---- private ----

  # Unique per-CI-run keychain to avoid collisions across retries or matrix jobs.
  def ios_keychain_name
    @ios_keychain_name ||= "shruti-build-#{ENV.fetch('GITHUB_RUN_ID', Process.pid)}.keychain"
  end

  IOS_KEYCHAIN_PASSWORD = "shruti-ephemeral"

  private_lane :setup_ios_keychain do
    # Sweep orphaned keychains from previously crashed runs. They share the
    # macOS user `akd` with us, sit in the search list (because past runs
    # used `add_to_search_list: true`), and hold copies of the same Apple
    # Distribution identity. codesign then has multiple candidates for the
    # same SHA1, picks one whose ACL/partition-list isn't ours, and the
    # SecurityAgent prompt for that keychain hangs the headless runner —
    # exact symptom seen on run 25316413229: SQLCipher.framework signed in
    # 37 minutes (silent UI prompt timing out), Cordova.framework then
    # failed instantly with errSecInternalComponent.
    sweep_orphan_ios_keychains

    # NOT default_keychain: true — all 5 self-hosted runners share the same
    # macOS user (akd) and therefore one ~/Library/Keychains. Setting default
    # makes parallel iOS jobs clobber each other's keychain in the user's
    # default search list, and xcodebuild then fails to find the cert with
    # `No "iOS Distribution" signing certificate matching team ID "***" with
    # a private key was found`. Defaults (`add_to_search_list: true`) append
    # each job's keychain to the user's search list — xcodebuild scans the
    # full list and finds the cert in whichever keychain holds it.
    create_keychain(
      name: ios_keychain_name,
      password: IOS_KEYCHAIN_PASSWORD,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    # Diagnostic only — print the user search list so we can see what
    # other keychains live alongside ours on this runner.
    sh("security list-keychains -d user", log: false)
  end

  # Remove leftover shruti-build-<runId>.keychain[-db] files (and their
  # search-list entries) for runs other than the current one. Fastlane's
  # `cleanup_keychain` only cleans the current run's keychain, so an aborted
  # job leaks one each time.
  def sweep_orphan_ios_keychains
    current = ios_keychain_name
    keychains_dir = File.expand_path("~/Library/Keychains")
    pattern = File.join(keychains_dir, "shruti-build-*.keychain*")

    orphans = Dir.glob(pattern).reject do |p|
      File.basename(p).start_with?(current)
    end

    if orphans.empty?
      UI.message("No orphan shruti-build-*.keychain files found")
    else
      UI.important("Sweeping #{orphans.size} orphan keychain file(s):")
      orphans.each { |p| UI.important("  #{File.basename(p)}") }
    end

    # Walk unique keychain names (strip -db suffix) and unlist+delete each.
    # `security delete-keychain` removes the file *and* the search-list entry.
    orphan_names = orphans.map { |p| p.sub(/-db\z/, "") }.uniq
    orphan_names.each do |kc|
      sh("security delete-keychain #{kc.shellescape} || true", log: false)
    end

    # And nuke any stray files that delete-keychain skipped (e.g., when the
    # keychain was never registered and only the file remains).
    orphans.each { |p| FileUtils.rm_f(p) }

    # Print the resulting search list so we can verify the runner is clean
    # before the build starts. Strictly diagnostic — cheap and safe.
    sh("security list-keychains -d user", log: false)
  end

  private_lane :import_ios_certificates do
    bundle_b64 = ENV.fetch("APPLE_CERTIFICATES")
    cert_pass = ENV.fetch("APPLE_CERTIFICATE_PASSWORD")
    work_dir = File.expand_path(File.join(MOBILE_ROOT, "fastlane/.apple-certs"))
    FileUtils.rm_rf(work_dir)
    FileUtils.mkdir_p(work_dir)

    zip_path = File.join(work_dir, "output.zip")
    File.binwrite(zip_path, Base64.decode64(bundle_b64))
    sh("unzip -o #{zip_path.shellescape} -d #{work_dir.shellescape}")

    Dir.glob(File.join(work_dir, "**/*.p12")).each do |p12|
      import_certificate(
        certificate_path: p12,
        keychain_name: ios_keychain_name,
        keychain_password: IOS_KEYCHAIN_PASSWORD,
        certificate_password: cert_pass,
      )
    end
    Dir.glob(File.join(work_dir, "**/*.cer")).each do |cer|
      import_certificate(
        certificate_path: cer,
        keychain_name: ios_keychain_name,
        keychain_password: IOS_KEYCHAIN_PASSWORD,
      )
    end

    # Allow codesign to use the imported private key without UI prompt.
    # `import_certificate` only adds -T entries to the key's ACL — codesign
    # still needs the partition list to permit access from non-bundled tools.
    # Without this, signing on self-hosted macOS dies with errSecInternalComponent
    # right after "Apple Distribution: ..." identity is selected.
    #
    # log: true on purpose — silent failures here are exactly what we just
    # spent two CI runs chasing.
    sh(
      "security set-key-partition-list " \
        "-S apple-tool:,apple:,codesign: " \
        "-s -k #{IOS_KEYCHAIN_PASSWORD.shellescape} #{ios_keychain_name.shellescape}",
    )

    # Print the codesigning identities visible in our keychain so the CI log
    # makes it obvious whether the import landed and whether duplicates exist
    # in the user's other keychains.
    sh("security find-identity -v -p codesigning #{ios_keychain_name.shellescape}", log: false)
    sh("security find-identity -v -p codesigning", log: false)
  end

  private_lane :install_ios_provisioning_profiles do
    work_dir = File.expand_path(File.join(MOBILE_ROOT, "fastlane/.apple-certs"))
    profiles = Dir.glob(File.join(work_dir, "**/*.mobileprovision"))
    UI.user_error!("No .mobileprovision found in APPLE_CERTIFICATES bundle") if profiles.empty?

    # We used to call fastlane's `install_provisioning_profile` action here,
    # but on Xcode 26.4 / macOS 26 self-hosted runners it started crashing
    # with "Error parsing provisioning profile" because its parse path
    # shells out to `security cms -D -i <file>` and the latter now returns
    # empty stdout (strict CMS verification regression in newer macOS, see
    # runs 25320394676 / 25321043983). Decode the CMS envelope ourselves
    # via openssl with `-noverify` so the install isn't gated on having
    # the WWDR intermediate trusted in the runner's user keychain — the
    # profile only needs to be readable by Xcode at sign time.
    require "plist"
    dest_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(dest_dir)

    profiles.each do |profile|
      plist_xml = `openssl cms -verify -noverify -inform DER -in #{profile.shellescape} 2>/dev/null`
      if plist_xml.empty?
        # Diagnostic dump if openssl also can't decode — surface stderr
        # so we know whether the file is corrupt or the envelope changed.
        sh("ls -la #{profile.shellescape}", log: false)
        sh("file #{profile.shellescape}", log: false)
        sh("openssl cms -verify -noverify -inform DER -in #{profile.shellescape} 2>&1 | head -20 || true", log: false)
        UI.user_error!("openssl cms returned empty for #{profile}")
      end

      parsed = Plist.parse_xml(plist_xml)
      uuid = parsed && parsed["UUID"]
      UI.user_error!("Could not extract UUID from #{profile}") if uuid.nil? || uuid.empty?

      dest = File.join(dest_dir, "#{uuid}.mobileprovision")
      FileUtils.cp(profile, dest)
      UI.message("Installed provisioning profile #{uuid} → #{dest}")
    end
  end

  private_lane :setup_app_store_connect_api_key do
    # Write the .p8 to a temp file and pass its path — passing the PEM via
    # key_content triggers "invalid curve name" in Ruby OpenSSL on arm64
    # macOS runners (fastlane/fastlane#21507).
    key_id = ENV.fetch("APPLE_STORE_CONNECT_API_KEY_ID")
    key_dir = File.join(Dir.tmpdir, "shruti-asc-key-#{Process.pid}")
    FileUtils.mkdir_p(key_dir)
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("APPLE_STORE_CONNECT_API_KEY")))
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("APPLE_STORE_CONNECT_API_KEY_ISSUER"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false,
    )
  end

  # Build number must come from CI ($GITHUB_RUN_NUMBER). Allowing a local upload
  # risks a versionCode collision in Play / build number clash on TestFlight.
  def require_ci_build_id!
    build_id = ci_build_id
    UI.user_error!("GITHUB_RUN_NUMBER env var is required (numeric) — store uploads must originate from CI") if build_id.empty?
    UI.user_error!("GITHUB_RUN_NUMBER must be numeric, got: #{build_id.inspect}") unless build_id.match?(/\A\d+\z/)
  end

  after_all do |lane|
    cleanup_ios_keychain if %i[build upload screenshots].include?(lane)
  end

  error do |lane, _|
    cleanup_ios_keychain if %i[build upload screenshots].include?(lane)
  end

  def cleanup_ios_keychain
    return unless @ios_keychain_name
    begin
      delete_keychain(name: @ios_keychain_name)
    rescue => e
      UI.important("Keychain cleanup failed (non-fatal): #{e.message}")
    end
    work_dir = File.expand_path(File.join(MOBILE_ROOT, "fastlane/.apple-certs"))
    FileUtils.rm_rf(work_dir)
  end
end
