{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": { "command": "npx vitest run" },
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": "../../../.stryker/incremental/mobile.json",
  "mutate": [
    "usecases/**/*.ts",
    "infra/**/*.ts",
    "lectorium/**/*.ts",
    "ui/**/*.ts",
    "submodules/domain/**/*.ts",
    "submodules/contracts/**/*.ts",
    "submodules/chat/**/*.ts",
    "submodules/ui/**/*.ts",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/*.d.ts",
    "!**/index.ts",
    "!**/types.ts",
    "!**/styles.ts",
    "!lectorium/main.ts",
    "!lectorium/i18n/locales/**"
  ],
  "reporters": ["clear-text", "progress"],
  "clearTextReporter": { "maxTestsToLog": 0 },
  "timeoutMS": 120000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 15,
  "concurrency": 4,
  "thresholds": { "high": 80, "low": 60, "break": 50 }
}
