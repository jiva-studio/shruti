{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": { "command": "cd apps/mobile && npx vitest run" },
  "coverageAnalysis": "off",
  "inPlace": true,
  "incremental": true,
  "incrementalFile": "../.stryker/incremental/mobile.json",
  "ignorePatterns": ["/*", "!/apps", "/apps/*", "!/apps/mobile", "!/libs"],
  "mutate": [
    "apps/mobile/usecases/**/*.ts",
    "apps/mobile/infra/**/*.ts",
    "apps/mobile/shruti/**/*.ts",
    "apps/mobile/ui/**/*.ts",
    "libs/domain/**/*.ts",
    "libs/contracts/**/*.ts",
    "libs/chat/**/*.ts",
    "libs/sync/**/*.ts",
    "libs/ui/**/*.ts",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/*.d.ts",
    "!**/index.ts",
    "!**/types.ts",
    "!**/styles.ts",
    "!apps/mobile/shruti/main.ts",
    "!apps/mobile/shruti/i18n/locales/**"
  ],
  "reporters": ["clear-text", "progress"],
  "clearTextReporter": { "maxTestsToLog": 0 },
  "timeoutMS": 120000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 15,
  "concurrency": 4,
  "thresholds": { "high": 80, "low": 60, "break": 50 }
}
