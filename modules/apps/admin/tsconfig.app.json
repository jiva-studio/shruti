{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "submodules/**/*"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@lectorium/admin/*": ["./src/*"],
      "@lectorium/protocol": ["./submodules/protocol"],
      "@lectorium/dal": ["./submodules/dal"]
    }
  }
}
