# Production backend (Global region). Caddy edge serves CORS * so the browser can call it directly.
PUBLIC_AUTH_API_URL=https://api.shruti.local
PUBLIC_CHAT_API_URL=https://api.shruti.local
# Paymento crypto-billing service (USDT one-time PRO checkout).
PUBLIC_BILLING_API_URL=https://api.shruti.local
# Profile service — enables the read-only chat-history pull (useProfileSync).
# Same Global origin; Caddy routes POST {base}/profile/sync/*. Leave EMPTY to
# disable the web sync entirely (it no-ops, no fallback) until /profile is routed.
PUBLIC_PROFILE_API_URL=https://api.shruti.local

# Track media (audio/video/covers/shares/pdf exports) — served by the Bunny.net
# CDN (US+EU edge). Falls back to this default if unset.
PUBLIC_LECTORIUM_MEDIA_BASE_URL=https://akds-lectorium.b-cdn.net

# Social sign-in. The ID tokens these mint are verified by the auth service
# against LECTORIUM_GOOGLE_CLIENT_IDS / LECTORIUM_APPLE_BUNDLE_IDS — the same
# contract the native app uses.
#
# Google: reuse the existing "web" OAuth client id (already in
# LECTORIUM_GOOGLE_CLIENT_IDS). Add the site origin to its Authorized
# JavaScript origins in the Google Cloud console.
PUBLIC_GOOGLE_CLIENT_ID=315690032552-hn1sgjk1m7fn38q41pupavep7idpnqoq.apps.googleusercontent.com
# Apple: a dedicated Services ID (NOT the native bundle id) with the site
# domain verified and the redirect URL registered in the Apple Developer
# portal. Add this Services ID to LECTORIUM_APPLE_BUNDLE_IDS. Leave empty to
# hide the Apple button until configured.
PUBLIC_APPLE_SERVICES_ID=
PUBLIC_APPLE_REDIRECT_URI=https://shruti.app
