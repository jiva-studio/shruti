# Production backend (Global region). Caddy edge serves CORS * so the browser can call it directly.
PUBLIC_AUTH_API_URL=https://api.shruti.local
PUBLIC_CHAT_API_URL=https://api.shruti.local
# Paymento crypto-billing service (USDT one-time PRO checkout).
PUBLIC_BILLING_API_URL=https://api.shruti.local

# Social sign-in. The ID tokens these mint are verified by the auth service
# against SHRUTI_GOOGLE_CLIENT_IDS / SHRUTI_APPLE_BUNDLE_IDS — the same
# contract the native app uses.
#
# Google: reuse the existing "web" OAuth client id (already in
# SHRUTI_GOOGLE_CLIENT_IDS). Add the site origin to its Authorized
# JavaScript origins in the Google Cloud console.
PUBLIC_GOOGLE_CLIENT_ID=
# Apple: a dedicated Services ID (NOT the native bundle id) with the site
# domain verified and the redirect URL registered in the Apple Developer
# portal. Add this Services ID to SHRUTI_APPLE_BUNDLE_IDS. Leave empty to
# hide the Apple button until configured.
PUBLIC_APPLE_SERVICES_ID=
PUBLIC_APPLE_REDIRECT_URI=https://shruti.app
