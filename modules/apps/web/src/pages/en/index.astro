---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Landing from '../../components/Landing.astro'
import { useT } from '../../i18n/ui'
const t = useT('en')
---
<BaseLayout
  lang="en"
  path="/"
  title={`${t('hero.title')} — ${t('hero.subtitle')}`}
