---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import WebApp from '../../../../components/vue/WebApp.vue'
import TopicDetail from '../../../../components/TopicDetail.astro'
import { topics, pickName } from '../../../../lib/catalog'
import type { TopicIndexEntry } from '@lib/catalog/types.js'

const lang = 'en'

export function getStaticPaths() {
  return topics.map((tp) => ({ params: { topic: tp.slug }, props: { topic: tp } }))
}

const { topic } = Astro.props as { topic: TopicIndexEntry }
const name = pickName(topic.names, lang)
---
<BaseLayout
  lang={lang}
  path={`/app/topics/${topic.slug}`}
  fullscreen
  title={`${name} — ${lang === 'en' ? 'Shruti' : 'Слушай Садху'}`}
  description={`Lectures on ${name} — listen online or in the app.`}
  image={topic.cover ?? undefined}
>
  <WebApp client:load lang={lang}>
    <TopicDetail slot="left" topic={topic} lang={lang} />
  </WebApp>
</BaseLayout>
