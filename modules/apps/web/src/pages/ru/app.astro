---
import BaseLayout from '../../layouts/BaseLayout.astro'
import WebApp from '../../components/vue/WebApp.vue'
import LibraryHub from '../../components/LibraryHub.astro'
import { useT } from '../../i18n/ui'
const lang = 'ru'
const t = useT(lang)
---
<BaseLayout
  lang={lang}
  path="/app"
  fullscreen
  title={`${t('app.browseTitle')} — ${t('hero.title')}`}
  description={t('library.lead')}
>
  <WebApp client:load lang={lang}>
    <LibraryHub slot="left" lang={lang} />
  </WebApp>
</BaseLayout>
