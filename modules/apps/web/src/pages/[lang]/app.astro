---
import BaseLayout from '../../layouts/BaseLayout.astro'
import WebApp from '../../components/vue/WebApp.vue'
import LibraryHub from '../../components/LibraryHub.astro'
import { useT, type Lang } from '../../i18n/ui'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }]
}

const lang = Astro.params.lang as Lang
const t = useT(lang)
---
<BaseLayout
  lang={lang}
  path="/app"
  fullscreen
  noindex
  title={`${t('app.browseTitle')} — ${t('hero.title')}`}
  description={t('library.lead')}
>
  <WebApp client:load lang={lang}>
    <LibraryHub slot="left" lang={lang} />
  </WebApp>
</BaseLayout>
