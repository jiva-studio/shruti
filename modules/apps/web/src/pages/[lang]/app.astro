---
import BaseLayout from '../../layouts/BaseLayout.astro'
import WebApp from '../../components/vue/WebApp.vue'
import LibraryHub from '../../components/LibraryHub.astro'
import { useT, type Lang } from '../../i18n/ui'
import { UI_LOCALE_CODES } from '../../i18n/locales.data.mjs'

export function getStaticPaths() {
  return UI_LOCALE_CODES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useT(lang)
---
<BaseLayout
  lang={lang}
  path="/app"
  fullscreen
  noindex
  title={`${t('app.browseTitle')} — ${t('hero.title')}`}
  description={t('library.lead')}
>
  <WebApp client:load lang={lang}>
    <LibraryHub slot="left" lang={lang} />
  </WebApp>
</BaseLayout>
