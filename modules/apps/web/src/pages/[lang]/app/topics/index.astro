---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import WebApp from '../../../../components/vue/WebApp.vue'
import TopicsGrid from '../../../../components/TopicsGrid.astro'
import { useT, type Lang } from '../../../../i18n/ui'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }]
}

const lang = Astro.params.lang as Lang
const t = useT(lang)
---
<BaseLayout
  lang={lang}
  path="/app/topics"
  fullscreen
  title={`${t('topics.title')} — ${t('hero.title')}`}
  description={t('topics.lead')}
>
  <WebApp client:load lang={lang}>
    <TopicsGrid slot="left" lang={lang} />
  </WebApp>
</BaseLayout>
