---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import WebApp from '../../../../components/vue/WebApp.vue'
import BrowseCatalog from '../../../../components/BrowseCatalog.astro'
import { useT, type Lang } from '../../../../i18n/ui'
import { UI_LOCALE_CODES } from '../../../../i18n/locales.data.mjs'

export function getStaticPaths() {
  return UI_LOCALE_CODES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useT(lang)
---
<BaseLayout
  lang={lang}
  path="/app/collections"
  fullscreen
  title={`${t('collections.title')} — ${t('hero.title')}`}
  description={t('collections.lead')}
>
  <WebApp client:load lang={lang}>
    <BrowseCatalog slot="left" lang={lang} kind="collections" page={1} />
  </WebApp>
</BaseLayout>
