---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import WebApp from '../../../../components/vue/WebApp.vue'
import CollectionDetail from '../../../../components/CollectionDetail.astro'
import { collections, pickName } from '../../../../lib/catalog'
import { useT, type Lang } from '../../../../i18n/ui'
import type { CollectionIndexEntry } from '@lib/catalog/types.js'

export function getStaticPaths() {
  return (['en', 'ru'] as const).flatMap((lang) =>
    collections.map((c) => ({ params: { lang, collection: c.slug }, props: { collection: c } })),
  )
}

const lang = Astro.params.lang as Lang
const t = useT(lang)
const { collection } = Astro.props as { collection: CollectionIndexEntry }
const name = pickName(collection.names, lang)
const desc = pickName(collection.descriptions, lang)
---
<BaseLayout
  lang={lang}
  path={`/app/library/${collection.slug}`}
  fullscreen
  title={`${name} — ${t('site.name')}`}
  description={desc || name}
  image={collection.cover ?? undefined}
>
  <WebApp client:load lang={lang}>
    <CollectionDetail slot="left" collection={collection} lang={lang} />
  </WebApp>
</BaseLayout>
