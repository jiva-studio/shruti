---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import WebApp from '../../../components/vue/WebApp.vue'
import { useT, type Lang } from '../../../i18n/ui'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }]
}

const lang = Astro.params.lang as Lang
const t = useT(lang)
---
<BaseLayout
  lang={lang}
  path="/app/search"
  fullscreen
  noindex
  title={`${t('search.title')} — ${t('hero.title')}`}
  description={t('app.searchAllLead')}
>
  <WebApp client:load lang={lang} />
</BaseLayout>
