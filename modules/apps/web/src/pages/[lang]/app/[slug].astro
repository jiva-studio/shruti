---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import WebApp from '../../../components/vue/WebApp.vue'
import type { LectureRecord, LectureVariant } from '@lib/catalog/types.js'
import { type Lang } from '../../../i18n/ui'
import { topicForId, pickName as pickLang } from '../../../lib/catalog'

export async function getStaticPaths() {
  const records = import.meta.glob('../../../../public/data/lectures/*.json', { eager: true, import: 'default' })
  const lectures = Object.values(records).map((rec) => rec as LectureRecord)
  return (['en', 'ru'] as const).flatMap((lang) =>
    lectures.map((r) => ({
      params: { lang, slug: r.slug.replace(/^track_/, '') },
      props: { lecture: r },
    })),
  )
}

const lang = Astro.params.lang as Lang
const { lecture } = Astro.props as { lecture: LectureRecord }
const { slug } = Astro.params

function pickName(map: Record<string, string> | undefined): string {
  if (!map) return ''
  return map[lang] || Object.values(map)[0] || ''
}

const variant: LectureVariant | null = lecture.variants[lang] ?? Object.values(lecture.variants)[0] ?? null
const title = variant?.title || lecture.id
const description = variant?.description || ''
const author = pickName(lecture.authorNames)
const location = pickName(lecture.locationNames)
const year = lecture.date ? lecture.date.slice(0, 4) : ''
const meta = [author, location, year].filter(Boolean).join(' · ')

const topics = (lecture.topicIds ?? []).map((id) => topicForId(id)).filter(Boolean)
const topicNames = topics.map((tp) => pickLang(tp!.names, lang)).filter(Boolean)

const audioUrl = variant?.audio?.url ?? ''
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'AudioObject',
  name: title,
  inLanguage: lang,
  ...(description ? { description } : {}),
  ...(author ? { author: { '@type': 'Person', name: author } } : {}),
  ...(audioUrl ? { contentUrl: audioUrl } : {}),
  ...(lecture.date ? { datePublished: lecture.date } : {}),
  ...(variant?.audio?.durationMs ? { duration: `PT${Math.round(variant.audio.durationMs / 1000)}S` } : {}),
  ...(topicNames.length ? { keywords: topicNames.join(', ') } : {}),
  ...(topicNames.length ? { about: topicNames.map((name) => ({ '@type': 'Thing', name })) } : {}),
}
---
<BaseLayout
  contentOnly
  lang={lang}
  path={`/app/${slug}`}
  fullscreen
  title={`${title}${meta ? ` — ${meta}` : ''}`}
  description={description || title}
>
  <WebApp client:load lang={lang} slug={slug} lecture={lecture} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
