---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import SubscribeSuccess from '../../../components/vue/SubscribeSuccess.vue'
import { useT, type Lang } from '../../../i18n/ui'
import { UI_LOCALE_CODES } from '../../../i18n/locales.data.mjs'

export function getStaticPaths() {
  return UI_LOCALE_CODES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useT(lang)
---
<BaseLayout lang={lang} path="/subscribe/success" noindex title={`${t('sub.success')} — ${t('hero.title')}`} description={t('sub.lead')}>
  <SubscribeSuccess client:load lang={lang} />
</BaseLayout>
