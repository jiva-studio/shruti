---
import '../styles/global.css'
import SiteNav from '../components/SiteNav.astro'
import Footer from '../components/Footer.astro'
import { defaultLang, type Lang } from '../i18n/ui'
import { UI_LOCALES, CONTENT_LOCALES, DEFAULT_LOCALE, contentLangFor, localizePath } from '../i18n/locales'

interface Props {
  title: string
  description: string
  lang?: Lang
  /** path WITHOUT locale prefix, e.g. "/" or "/chat" */
  path?: string
  /** Single-screen app shell: drop the footer and lock page scroll. */
  fullscreen?: boolean
  /** Social-card image: absolute URL or root-relative path. */
  image?: string
  /** Keep the page out of the index (interactive/thin app surfaces). */
  noindex?: boolean
  /** Page exists only in CONTENT_LOCALES (lecture/topic/collection detail);
   *  other UI locales collapse onto their content language for alternates. */
  contentOnly?: boolean
  /** Render the global site header. Off for app-like shells that carry their
   *  own chrome (e.g. the /ai chat, whose sidebar holds the logo). */
  nav?: boolean
}
const { title, description, lang = defaultLang, path = '/', fullscreen = false, image, noindex = false, contentOnly = false, nav = true } = Astro.props

const site = Astro.site?.toString().replace(/\/$/, '') ?? ''
// Locales this path actually exists in → hreflang alternates + switcher.
const alternates = contentOnly ? UI_LOCALES.filter((l) => CONTENT_LOCALES.includes(l.code)) : UI_LOCALES
const canonical = site + localizePath(path, lang, contentOnly)
const xDefaultHref = site + localizePath(path, DEFAULT_LOCALE, contentOnly)
const current = UI_LOCALES.find((l) => l.code === lang)

const rawImage = image ?? `/og-default.${contentLangFor(lang)}.jpg`
const ogImage = rawImage.startsWith('http') ? rawImage : site + rawImage
const siteName = contentLangFor(lang) === 'ru' ? 'Слушай Садху' : 'Shruti'
const ogLocale = current?.og ?? 'en_US'
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={site + localizePath(path, l.code, contentOnly)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {alternates.filter((l) => l.code !== lang).map((l) => (
      <meta property="og:locale:alternate" content={l.og} />
    ))}
    <meta property="og:image" content={ogImage} />
    {!image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f7f3ec" />
    <meta name="apple-itunes-app" content="app-id=6745510353" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
  </head>
  <body class={fullscreen ? 'h-screen overflow-hidden' : 'flex min-h-screen flex-col'}>
    {nav && <SiteNav lang={lang} path={path} contentOnly={contentOnly} />}
    <main class={fullscreen ? '' : 'flex-1'}>
      <slot />
    </main>
    {!fullscreen && <Footer lang={lang} />}
  </body>
</html>
