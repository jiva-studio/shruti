---
import '../styles/global.css'
import SiteNav from '../components/SiteNav.astro'
import Footer from '../components/Footer.astro'
import { defaultLang, type Lang } from '../i18n/ui'

interface Props {
  title: string
  description: string
  lang?: Lang
  /** path WITHOUT locale prefix, e.g. "/" or "/chat" */
  path?: string
  /** Single-screen app shell: drop the footer and lock page scroll. */
  fullscreen?: boolean
}
const { title, description, lang = defaultLang, path = '/', fullscreen = false } = Astro.props

const site = Astro.site?.toString().replace(/\/$/, '') ?? ''
const enPath = path === '/' ? '/en/' : `/en${path}`
const ruPath = path === '/' ? '/ru/' : `/ru${path}`
const canonical = site + (lang === 'en' ? enPath : ruPath)
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={site + ruPath} />
    <link rel="alternate" hreflang="en" href={site + enPath} />
    <link rel="alternate" hreflang="x-default" href={site + enPath} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class={fullscreen ? 'h-screen overflow-hidden' : 'min-h-screen'}>
    <SiteNav lang={lang} path={path} />
    <main>
      <slot />
    </main>
    {!fullscreen && <Footer lang={lang} />}
  </body>
</html>
