---
import { useT, type Lang } from '../i18n/ui'
interface Props { lang: Lang; path?: string }
const { lang } = Astro.props
const t = useT(lang)
const base = `/${lang}`
const home = `/${lang}/`
const links = [
  [home, t('nav.about')],
  [`${base}/app`, t('nav.library')],
]
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-cream/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a href={home} class="flex items-center gap-2 font-serif text-lg font-bold text-ink">
      <img src="/app-icon.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span>{lang === 'en' ? 'Shruti' : 'Слушай Садху'}</span>
    </a>

    <ul class="my-0 hidden h-full list-none items-center gap-6 p-0 text-sm leading-7 text-ink-soft md:flex">
      {links.map(([href, label]) => (
        <li class:list={['items-center', href.endsWith('/app') ? 'hidden lg:flex' : 'flex']}><a href={href} class="transition hover:text-saffron">{label}</a></li>
      ))}
    </ul>

    <a href={`${base}/#download`} class="ml-auto hidden rounded-lg bg-saffron px-4 py-2 text-sm font-semibold text-cream transition hover:bg-saffron-shade sm:inline-block">
      {t('nav.download')}
    </a>
  </nav>
</header>
