---
import { useT, type Lang } from '../i18n/ui'
import LanguageSwitcher from './LanguageSwitcher.astro'
interface Props { lang: Lang; path?: string; contentOnly?: boolean }
const { lang, path = '/', contentOnly = false } = Astro.props
const t = useT(lang)
const base = `/${lang}`
const home = `/${lang}/`
const links = [
  [home, t('nav.about')],
  [`${base}/app`, t('nav.library')],
]
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-cream/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a href={home} class="flex items-center gap-2 font-serif text-lg font-bold text-ink">
      <img src="/app-icon.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span>{t('site.name')}</span>
    </a>

    <ul class="my-0 hidden list-none items-center gap-6 p-0 text-sm text-ink-soft md:flex" style="transform: translateY(1.5px)">
      {links.map(([href, label]) => (
        <li class:list={['items-center', href.endsWith('/app') ? 'hidden lg:flex' : 'flex']}><a href={href} class="transition hover:text-saffron">{label}</a></li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-3">
      <LanguageSwitcher lang={lang} path={path} contentOnly={contentOnly} />
      <a href={`${base}/#download`} class="hidden h-9 items-center rounded-lg bg-saffron px-4 text-sm font-semibold text-cream transition hover:bg-saffron-shade sm:inline-flex">
        {t('nav.download')}
      </a>
    </div>
  </nav>
</header>
