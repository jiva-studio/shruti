---
import { useT, STORE, type Lang } from '../i18n/ui'
interface Props { lang: Lang }
const { lang } = Astro.props
const t = useT(lang)
const base = `/${lang}`
const year = 2026
const nav = [
  ['#about', t('nav.about')],
  ['#features', t('features.title')],
  ['#faq', t('faq.title')],
  ['#download', t('download.title')],
]
---
<footer class="mt-24 border-t border-line bg-cream-deep">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 md:grid-cols-4">
    <div class="sm:col-span-2 md:col-span-2">
      <div class="flex items-center gap-2 font-serif text-lg font-bold">
        <img src="/app-icon.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
        {lang === 'en' ? 'Shruti' : 'Слушай Садху'}
      </div>
      <p class="mt-3 max-w-sm text-sm text-medium">{t('footer.tagline')}</p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-ink">{t('footer.links')}</h3>
      <ul class="mt-3 space-y-2 text-sm text-medium">
        {nav.map(([href, label]) => (
          <li class={href === '#chat' ? 'hidden md:block' : undefined}><a href={`${base}/${href}`} class="hover:text-saffron">{label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-ink">{t('footer.follow')}</h3>
      <ul class="mt-3 space-y-2 text-sm text-medium">
        <li><a href={STORE.telegram} target="_blank" rel="noopener" class="hover:text-saffron">Telegram</a></li>
        <li><a href={STORE.vk} target="_blank" rel="noopener" class="hover:text-saffron">VK</a></li>
        <li><a href={`mailto:${STORE.email}`} class="hover:text-saffron">{t('footer.support')}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-medium">© {year} AKd Studio. {t('footer.rights')}</p>
  </div>
</footer>
