---
import { useT, type Lang } from '../i18n/ui'
import { collectionGroups, collectionForId, topics, pickName } from '../lib/catalog'
import CollectionCard from './CollectionCard.astro'
import TopicCard from './TopicCard.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const topicTeaser = topics.slice(0, 12)
---
<div class="mx-auto max-w-6xl px-5 py-12">
  <header class="max-w-2xl">
    <h1 class="font-serif text-3xl font-bold text-ink sm:text-4xl">{t('app.browseTitle')}</h1>
    <p class="mt-3 text-medium">{t('library.lead')}</p>
  </header>

  <a
    href={`/${lang}/app/search`}
    class="relative mt-8 flex items-center gap-4 overflow-hidden rounded-2xl border border-line bg-cream-deep px-5 py-4"
  >
    <img
      src="/library/search-bg.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-right"
    />
    <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-cream-deep from-40% to-transparent"></span>

    <span class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-saffron/15 text-saffron-shade">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" />
      </svg>
    </span>
    <span class="relative flex-1">
      <span class="block font-serif text-lg font-semibold text-ink">{t('app.searchAll')}</span>
      <span class="mt-0.5 block text-sm text-medium">{t('app.searchAllLead')}</span>
    </span>
    <span class="relative shrink-0 text-ink/90 drop-shadow-[0_1px_2px_rgba(255,255,255,0.85)]">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </a>

  {collectionGroups.map((group) => {
    const cols = group.collectionIds.map((id) => collectionForId(id)).filter(Boolean)
    const groupName = pickName(group.names, lang)
    const groupDesc = pickName(group.descriptions, lang)
    return (
      <section class="mt-12">
        <h2 class="font-serif text-2xl font-semibold text-ink">{groupName}</h2>
        {groupDesc && <p class="mt-2 max-w-3xl text-sm text-medium">{groupDesc}</p>}
        <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {cols.map((c) => <CollectionCard collection={c} lang={lang} />)}
        </div>
      </section>
    )
  })}

  <section class="mt-16">
    <div class="flex items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="font-serif text-2xl font-semibold text-ink">{t('library.topicsTitle')}</h2>
        <p class="mt-2 text-sm text-medium">{t('library.topicsLead')}</p>
      </div>
      <a href={`/${lang}/app/topics`} class="shrink-0 text-sm font-semibold text-saffron-shade transition hover:text-saffron">
        {t('library.allTopics')} →
      </a>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {topicTeaser.map((topic) => <TopicCard topic={topic} lang={lang} />)}
    </div>
  </section>
</div>
