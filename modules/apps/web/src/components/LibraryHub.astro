---
import { useT, type Lang } from '../i18n/ui'
import { collectionGroups } from '../lib/catalog'
import SearchBanner from './SearchBanner.astro'
import CollectionGroupSection from './CollectionGroupSection.astro'
import TopicTeaser from './TopicTeaser.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
---
<div class="mx-auto max-w-6xl px-5 py-12">
  <header class="max-w-2xl">
    <h1 class="font-serif text-3xl font-bold text-ink sm:text-4xl">{t('app.browseTitle')}</h1>
    <p class="mt-3 text-medium">{t('library.lead')}</p>
  </header>

  <div class="mt-8">
    <SearchBanner lang={lang} />
  </div>

  {collectionGroups.map((group) => <CollectionGroupSection group={group} lang={lang} />)}

  <TopicTeaser lang={lang} />
</div>
