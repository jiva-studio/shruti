---
import type { CollectionIndexEntry } from '@lib/catalog/types.js'
import { useT, type Lang } from '../i18n/ui'
import { lecturesByIdsForLang, pickName, shortSlug } from '../lib/catalog'
import { lectureTitle } from '../lib/lectureDisplay'
import LectureListPage from './LectureListPage.astro'

interface Props {
  collection: CollectionIndexEntry
  lang: Lang
}
const { collection, lang } = Astro.props
const t = useT(lang)
const name = pickName(collection.names, lang)
const desc = pickName(collection.descriptions, lang)
const lectures = lecturesByIdsForLang(collection.trackIds, lang)
const site = Astro.site?.toString().replace(/\/$/, '') ?? ''
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name,
  ...(desc ? { description: desc } : {}),
  inLanguage: lang,
  url: `${site}/${lang}/app/library/${collection.slug}`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: lectures.length,
    itemListElement: lectures.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site}/${lang}/app/${shortSlug(l.slug)}`,
      name: lectureTitle(l, lang),
    })),
  },
}
---
<script type="application/ld+json" set:html={JSON.stringify(collectionLd)} is:inline />
<LectureListPage
  lang={lang}
  kicker={t('collection.kicker')}
  title={name}
  count={lectures.length}
  lectures={lectures}
  backHref={`/${lang}/app`}
  backLabel={t('common.backToLibrary')}
  cover={collection.cover ?? undefined}
  coverClass="max-w-xs"
  description={desc || undefined}
/>
