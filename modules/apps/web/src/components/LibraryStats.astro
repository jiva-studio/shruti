---
import LibraryStatsIsland from './vue/LibraryStats.vue'
import { type Lang } from '../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<!-- Library-size stat band (lecture count + total hours), fed by the analytics
     library_totals report. Sits to the right of the listened-counter. -->
<LibraryStatsIsland client:load lang={lang} />
