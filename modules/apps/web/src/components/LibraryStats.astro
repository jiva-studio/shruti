---
import LibraryStatsIsland from './vue/LibraryStats.vue'
import { type Lang } from '../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<!-- One-line library size stat (lecture count + total hours), fed by the
     analytics library_totals report. Hides itself if unavailable. -->
<div class="pb-10">
  <LibraryStatsIsland client:load lang={lang} />
</div>
