---
import { useT, type Lang } from '../i18n/ui'
import { topics } from '../lib/catalog'
import TopicCard from './TopicCard.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
---
<div class="mx-auto max-w-6xl px-5 py-12">
  <header class="max-w-2xl">
    <h1 class="font-serif text-3xl font-bold text-ink sm:text-4xl">{t('topics.title')}</h1>
    <p class="mt-3 text-medium">{t('topics.lead')}</p>
  </header>

  <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    {topics.map((topic) => <TopicCard topic={topic} lang={lang} />)}
  </div>
</div>
