---
import ListenedCounterIsland from './vue/ListenedCounter.vue'
import { type Lang } from '../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<!-- Live "hours listened together" counter. The island fetches the
     listening_daily report from the analytics service, sums the base, derives
     a growth rate and ticks the number forward. It hides itself when the
     report is unavailable, so a backend hiccup never leaves an empty band. -->
<section class="py-12">
  <ListenedCounterIsland client:load lang={lang} />
</section>
