---
import ListenedCounterIsland from './vue/ListenedCounter.vue'
import { type Lang } from '../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<!-- Live "hours listened together" counter band. Laid out beside LibraryStats
     by Landing; renders as a full-height dark band, hidden until its report
     loads. -->
<ListenedCounterIsland client:load lang={lang} />
