---
import StoreBadges from './StoreBadges.astro'
import HeroSection from './HeroSection.astro'
import ScreenshotShowcase from './ScreenshotShowcase.astro'
import FeatureList from './FeatureList.astro'
import ListenedCounter from './ListenedCounter.astro'
import WisdomSection from './WisdomSection.astro'
import CTABand from './CTABand.astro'
import AIAgentFeatures from './AIAgentFeatures.astro'
import WatchCarousel from './WatchCarousel.astro'
import FAQSection from './FAQSection.astro'
import { useT, STORE, type Lang } from '../i18n/ui'
interface Props { lang: Lang }
const { lang } = Astro.props
const t = useT(lang)
const chatHref = `/${lang}/app`
const aiHref = `/${lang}/ai`

const site = Astro.site?.toString().replace(/\/$/, '') ?? ''
const siteName = t('site.name')
const homeLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#org`,
      name: siteName,
      url: `${site}/`,
      logo: `${site}/app-icon.png`,
      sameAs: [STORE.telegram, STORE.vk],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: siteName,
      url: `${site}/`,
      inLanguage: lang,
      publisher: { '@id': `${site}/#org` },
    },
    {
      '@type': 'MobileApplication',
      name: siteName,
      description: t('hero.lead'),
      operatingSystem: 'iOS, Android',
      applicationCategory: 'EducationApplication',
      url: `${site}/`,
      installUrl: [STORE.appStore, STORE.googlePlay],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
}
---
<script type="application/ld+json" set:html={JSON.stringify(homeLd)} is:inline />

<HeroSection lang={lang} />

<ScreenshotShowcase lang={lang} />

<FeatureList lang={lang} />

<ListenedCounter lang={lang} />

<WisdomSection lang={lang} />

<CTABand id="listen" bg="/cta-bg.jpg" title={t('chat.band.title')} lead={t('chat.band.lead')} sectionClass="pb-5 pt-10">
  <a href={chatHref} class="inline-flex items-center gap-2 rounded-xl bg-saffron px-6 py-3 font-semibold text-ink transition hover:bg-saffron-tint">
    {t('chat.band.cta')} →
  </a>
</CTABand>

<WatchCarousel lang={lang} />

<AIAgentFeatures lang={lang} />

<CTABand id="ai" bg="/cta-ai-bg.jpg" title={t('ai.band.title')} lead={t('ai.band.lead')} sectionClass="pb-10 pt-5">
  <div class="flex flex-wrap gap-3">
    <a href={aiHref} class="inline-flex items-center gap-2 rounded-xl bg-saffron px-6 py-3 font-semibold text-ink transition hover:bg-saffron-tint">
      {t('ai.band.chat')} →
    </a>
    <a href="https://mcp.shruti.app" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-cream/25 bg-cream/10 px-6 py-3 font-semibold text-cream backdrop-blur transition hover:bg-cream/20">
      {t('ai.band.connect')} →
    </a>
  </div>
</CTABand>

<FAQSection lang={lang} />

<CTABand
  id="download"
  bg="/getapp-bg.jpg"
  title={t('download.title')}
  lead={t('download.lead')}
  sectionClass="py-16"
  contentClass="max-w-md lg:max-w-2xl"
  actionClass="mt-8"
>
  <StoreBadges
    full
    onDark
    apkEyebrow={t('download.apkEyebrow')}
    apkLabel={t('download.apkLabel')}
  />
</CTABand>
