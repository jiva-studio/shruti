---
import type { LectureIndexEntry } from '@lib/catalog/types.js'
import type { Lang } from '../i18n/ui'

interface Props {
  entry: LectureIndexEntry
  lang: Lang
}
const { entry, lang } = Astro.props

function pick(map: Record<string, string>): string {
  if (map[lang]) return map[lang]
  const first = Object.values(map)[0]
  return first ?? ''
}

const title = pick(entry.titles) || entry.id
const author = pick(entry.authorNames)
const location = pick(entry.locationNames)
const year = entry.date ? entry.date.slice(0, 4) : ''

const refs = entry.refs
  .map((r) => {
    const short = r.shortNames[lang] ?? Object.values(r.shortNames)[0] ?? ''
    return short ? `${short} ${r.tokens}`.trim() : r.tokens
  })
  .filter(Boolean)

const meta = [author, location, year].filter(Boolean)
const href = lang === 'en' ? `/en/lectures/${entry.slug}` : `/lectures/${entry.slug}`
---
<a
  href={href}
  class="group block rounded-2xl border border-line bg-cream-deep px-5 py-4 transition hover:border-saffron/50 hover:shadow-md"
>
  <h3 class="text-lg font-semibold leading-snug text-ink transition group-hover:text-saffron-shade">
    {title}
  </h3>

  {meta.length > 0 && (
    <p class="mt-1.5 text-sm text-medium">
      {meta.join(' · ')}
    </p>
  )}

  {refs.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {refs.map((ref) => (
        <span class="rounded-md bg-surface px-2 py-0.5 text-xs font-medium text-coffee">
          {ref}
        </span>
      ))}
    </div>
  )}
</a>
