---
import { wisdomForLang, lecturesByIds } from '../lib/catalog'
import { lectureTitle, lectureRefs, pickName } from '../lib/lectureDisplay'
import WebCitationCard from './vue/WebCitationCard.vue'
import { useT, type Lang } from '../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useT(lang)

// A handful of fragments in the page's content language, enriched with the
// lecture's author / title / date / scripture reference so each card carries
// its attribution (the same data the in-app wisdom card shows). The section
// hides itself when the catalog ships no fragments for this language.
const items = wisdomForLang(lang)
  .slice(0, 9)
  .map((w) => {
    const lecture = lecturesByIds([w.trackId])[0]
    const ref = lecture ? lectureRefs(lecture, lang)[0] : ''
    return {
      w,
      body: {
        text: w.text,
        trackTitle: lecture ? lectureTitle(lecture, lang) : undefined,
        authorName: lecture ? pickName(lecture.authorNames, lang) : undefined,
        trackDate: lecture?.date ?? undefined,
        references: ref ? [{ label: ref }] : undefined,
      },
    }
  })
---

{
  items.length > 0 && (
    <section id="wisdom" class="mx-auto max-w-6xl px-5 py-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold text-ink sm:text-4xl">{t('wisdom.title')}</h2>
        <p class="mt-3 text-medium">{t('wisdom.lead')}</p>
      </div>
      <div class="mt-12 columns-1 gap-5 sm:columns-2 lg:columns-3">
        {items.map(({ w, body }) => (
          <div class="mb-5 break-inside-avoid">
            <WebCitationCard
              client:visible
              trackId={w.trackId}
              startMs={w.startMs}
              endMs={w.endMs}
              body={body}
              language={w.language}
            />
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  /* The shared CitationCard carries `margin: 10px 0` for chat flow; in this
     masonry grid the column gap owns the spacing, so strip the card's own
     vertical margin (otherwise the first card in each column gets a stray
     top inset). */
  #wisdom :global(.citation-card) {
    margin: 0;
  }
</style>
