---
import StoreBadges from './StoreBadges.astro'
import { useT, type Lang } from '../i18n/ui'
interface Props { lang: Lang }
const { lang } = Astro.props
const t = useT(lang)
---
<section id="about" class="relative overflow-hidden">
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-saffron/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-24 top-40 h-72 w-72 rounded-full bg-moss/10 blur-3xl"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-56 md:pb-24 md:pt-[24rem] xl:grid-cols-2 xl:py-24">
    <div class="relative text-center xl:translate-y-28 xl:text-left">
      <img
        src="/hero-prabhupada.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-0 -z-10 w-[150%] max-w-none -translate-x-1/2 -translate-y-[62%] select-none opacity-25 md:max-w-[620px] xl:left-[35%] xl:max-w-[640px]"
        style="-webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent); mask-image: radial-gradient(closest-side, #000 62%, transparent);"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -inset-x-12 -inset-y-24 -z-[1]"
        style="background: var(--color-cream); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 42% 78%, transparent 100%), linear-gradient(to right, transparent 0%, #000 14% 86%, transparent 100%); -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, transparent 0%, #000 42% 78%, transparent 100%), linear-gradient(to right, transparent 0%, #000 14% 86%, transparent 100%); mask-composite: intersect;"
      ></div>
      <h1 class="text-4xl font-bold leading-[1.05] text-ink sm:text-5xl xl:text-6xl">{t('hero.title')}</h1>
      <p class="mt-5 text-xl text-coffee sm:text-2xl">{t('hero.subtitle')}</p>
      <p class="mt-5 max-w-md text-base leading-relaxed text-medium mx-auto xl:mx-0">{t('hero.lead')}</p>
      <div class="mt-8 max-w-md mx-auto xl:mx-0"><StoreBadges full class="justify-center xl:justify-start" /></div>
    </div>

    <div class="relative mx-auto w-full max-w-sm">
      <div class="absolute inset-0 -rotate-3 rounded-[2.2rem] bg-gradient-to-br from-saffron/25 to-coffee/15"></div>
      <div class="relative overflow-hidden rounded-[2rem] border-4 border-ink bg-cream py-[4.5%] shadow-2xl">
        <img src={`/screens/${lang}/01_home.png?v=3`} alt={t('hero.title')} class="block w-full" />
      </div>
    </div>
  </div>
</section>
