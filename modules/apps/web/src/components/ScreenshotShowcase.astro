---
import ScreenshotGallery from './ScreenshotGallery.astro'
import SHOT_BG from '../data/screenshots.json'
import type { Lang } from '../i18n/ui'
interface Props { lang: Lang }
const { lang } = Astro.props

const shots = lang === 'ru'
  ? [
      ['01_home', 'Отслеживание прогресса', 'Серия дней и продолжение с того места, где остановились.'],
      ['02_search', 'Поиск и фильтры', 'Находите лекции по теме, автору и дате.'],
      ['03_chat', 'Спроси Садху', 'Понятный ответ со ссылками на конкретные лекции.'],
      ['07_media', 'Воспоминания о Прабхупаде', 'Ассистент находит и показывает видео-воспоминания учеников.'],
      ['04_transcript', 'Текст рядом с аудио', 'Читайте и слушайте одновременно — текущий абзац перед глазами.'],
      ['06_notes', 'Закладки на важные мысли', 'Сохраняйте фрагменты транскрипта и возвращайтесь к нужной секунде.'],
      ['05_track', 'Каждая лекция в деталях', 'Описание, содержание по главам и темы — всё на одном экране.'],
      ['07_library', 'Тысячи лекций', 'По «Гите», «Бхагаватам» и другим писаниям — всегда под рукой.'],
    ]
  : [
      ['01_home', 'Track your progress', 'A day streak and picking up right where you left off.'],
      ['02_search', 'Search & filters', 'Find lectures by topic, author and date.'],
      ['03_chat', 'Ask Sadhu', 'A clear answer with links to the specific lectures.'],
      ['07_media', 'Memories of Prabhupāda', 'The assistant finds and plays disciples’ remembrance videos.'],
      ['04_transcript', 'Text beside the audio', 'Read and listen at once — the current passage in view.'],
      ['06_notes', 'Bookmark what matters', 'Save transcript snippets and jump back to the exact second.'],
      ['05_track', 'Every lecture in detail', 'Description, chapter outline and topics — all on one screen.'],
      ['07_library', 'Thousands of lectures', 'On the Gita, the Bhagavatam and other scriptures — always at hand.'],
    ]

const bg = SHOT_BG as Record<string, { top: string; bottom: string }>
const slides = shots.map(([file, title, desc]) => ({
  src: `/screens/${lang}/${file}.png?v=3`,
  title,
  desc,
  top: bg[file]?.top ?? '#faf5ea',
  bottom: bg[file]?.bottom ?? '#d4a986',
}))
---
<section class="relative overflow-hidden bg-cream-deep/50 py-16">
  <img
    src="/hero-feather.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-[2%] top-[58%] z-0 hidden w-[380px] -translate-y-1/2 -scale-x-100 select-none opacity-80 md:block"
  />
  <img
    src="/hero-feather.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-[6%] top-2 z-0 hidden w-[340px] rotate-[270deg] select-none opacity-80 md:block"
  />
  <div class="relative z-10">
    <div class="mx-auto mb-10 max-w-2xl px-5 text-center">
      <h2 class="text-3xl font-bold text-ink sm:text-4xl">{lang === 'en' ? 'A look inside' : 'Как выглядит приложение'}</h2>
    </div>
    <ScreenshotGallery slides={slides} />
  </div>
</section>
