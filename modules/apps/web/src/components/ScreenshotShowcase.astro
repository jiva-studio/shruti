---
import MediaCarousel from './MediaCarousel.astro'
import SHOT_BG from '../data/screenshots.json'
import { useT, type Lang, type UiKey } from '../i18n/ui'
interface Props { lang: Lang }
const { lang } = Astro.props
const t = useT(lang)

// Display order; captions come from the `gallery.<file>.{t,d}` i18n keys.
const FILES = ['01_home', '02_search', '03_chat', '07_media', '04_transcript', '06_notes', '05_track', '07_library']
const shots = FILES.map((file) => [file, t(`gallery.${file}.t` as UiKey), t(`gallery.${file}.d` as UiKey)])

const bg = SHOT_BG as Record<string, { top: string; bottom: string }>
const slides = shots.map(([file, title, desc]) => ({
  src: `/screens/${lang}/${file}.png?v=3`,
  title,
  desc,
  top: bg[file]?.top ?? '#faf5ea',
  bottom: bg[file]?.bottom ?? '#d4a986',
}))
---
<section class="relative overflow-hidden bg-cream-deep/50 py-16">
  <img
    src="/hero-feather.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-[2%] top-[58%] z-0 hidden w-[380px] -translate-y-1/2 -scale-x-100 select-none opacity-80 md:block"
  />
  <img
    src="/hero-feather.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-[6%] top-2 z-0 hidden w-[340px] rotate-[270deg] select-none opacity-80 md:block"
  />
  <div class="relative z-10">
    <div class="mx-auto mb-10 max-w-2xl px-5 text-center">
      <h2 class="text-3xl font-bold text-ink sm:text-4xl">{t('gallery.heading' as UiKey)}</h2>
    </div>
    <MediaCarousel slides={slides} />
  </div>
</section>
