{
  "gates": {
    "dependency-cruiser": {
      "config_candidates": [
        "modules/apps/mobile/.dependency-cruiser.cjs",
        "modules/apps/mobile/.dependency-cruiser.js",
        "modules/.dependency-cruiser.cjs",
        "modules/.dependency-cruiser.js",
        ".dependency-cruiser.cjs",
        ".dependency-cruiser.js"
      ],
      "workdir": "{config_dir}",
      "command": ["npx", "--no-install", "depcruise", "--config", "{config}", "--output-type", "err", "{path}"]
    },
    "eslint": {
      "workdir": "modules/apps/mobile",
      "command": ["npx", "--no-install", "eslint", "--no-warn-ignored", "{path}"]
    },
    "test_layering": {
      "workdir": "modules/services/chat/app",
      "command": ["uv", "run", "--locked", "--extra", "dev", "python", "-m", "pytest", "tests/test_layering.py", "-q", "-p", "no:cacheprovider"]
    },
    "depguard": {
      "workdir": "{module_dir}",
      "command": ["{golangci_lint}", "run", "--allow-parallel-runners", "--enable-only", "depguard", "./{package_rel}/..."]
    },
    "errcheck": {
      "workdir": "{module_dir}",
      "command": ["{golangci_lint}", "run", "--allow-parallel-runners", "--enable-only", "errcheck", "./{package_rel}/..."]
    }
  },
  "entries": [
    {
      "id": "ts-multiline-import",
      "fixture": "ts/modules/libs/domain/gatefixture_multiline_import.ts",
      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-dynamic-import",
      "fixture": "ts/modules/libs/domain/gatefixture_dynamic_import.ts",
      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-relative-import",
      "fixture": "ts/modules/libs/domain/gatefixture_relative_import.ts",
      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-lib-ui-imports-domain",
      "fixture": "ts/modules/libs/ui/gatefixture_lib_domain.ts",
      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-domain-in-ui",
      "fixture": "ts/modules/apps/mobile/ui/shared/gatefixture_domain_in_ui.ts",
      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-view-imports-infra",
      "fixture": "ts/modules/apps/mobile/shruti/views/Home/gatefixture_view_infra.ts",
      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-wire-lib-imports-vue",
