      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-mobile-imports-web",
      "fixture": "ts/modules/apps/mobile/shruti/services/gatefixture_imports_web.ts",
      "gate": "dependency-cruiser",
      "status": "pending",
      "activate_when": { "any_exists": "gate:dependency-cruiser" }
    },
    {
      "id": "ts-date-now-in-domain",
      "fixture": "ts/modules/libs/domain/gatefixture_date_now.ts",
      "gate": "eslint",
      "path": "submodules/domain/gatefixture_date_now.ts",
      "status": "pending",
      "activate_when": { "file": "modules/apps/mobile/eslint.config.js", "matches": "files:\\s*\\[[^\\]]*submodules/domain[^\\]]*\\][\\s\\S]{0,2000}?object\\.name=\"Date\"\\]\\[property\\.name=\"now\"\\]" }
    },
    {
      "id": "py-relative-infra-in-domain",
      "fixture": "py/modules/services/chat/app/src/shruti_chat/domain/gatefixture_relative_infra.py",
      "gate": "test_layering",
      "status": "active"
    },
    {
      "id": "py-config-in-application",
      "fixture": "py/modules/services/chat/app/src/shruti_chat/application/gatefixture_config.py",
      "gate": "test_layering",
      "status": "pending",
      "activate_when": { "file": "modules/services/chat/app/tests/test_layering.py", "matches": "\\{_PKG\\}\\.config\"|shruti_chat\\.config\"" }
    },
    {
      "id": "py-observability-imports-agent",
