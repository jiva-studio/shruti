{
  "gates": {
    "dependency-cruiser": {
      "requires": [
        "modules/apps/mobile/.dependency-cruiser.cjs"
      ],
      "workdir": "modules/apps/mobile",
      "command": [
        "npx",
        "--no-install",
        "depcruise",
        "--config",
        ".dependency-cruiser.cjs",
        "--output-type",
        "err",
        "{path}"
      ]
    },
    "eslint": {
      "requires": [
        "modules/apps/mobile/eslint.config.js"
      ],
      "workdir": "modules/apps/mobile",
      "command": [
        "npx",
        "--no-install",
        "eslint",
        "--no-warn-ignored",
        "{path}"
      ]
    },
    "test_layering": {
      "requires": [
        "modules/services/chat/app/tests/test_layering.py"
      ],
      "workdir": "modules/services/chat/app",
      "command": [
        "uv",
        "run",
        "--locked",
        "--extra",
        "dev",
        "python",
        "-m",
        "pytest",
        "tests/test_layering.py",
        "-q",
        "-p",
        "no:cacheprovider"
      ]
    },
    "depguard": {
      "requires": [
        "modules/.golangci.yml"
      ],
      "workdir": "{module_dir}",
      "command": [
        "{golangci_lint}",
        "run",
        "--allow-parallel-runners",
        "--enable-only",
        "depguard",
        "./{package_rel}/..."
      ]
    },
    "forbidigo": {
      "requires": [
        "modules/.golangci.yml"
      ],
      "workdir": "{module_dir}",
      "command": [
        "{golangci_lint}",
        "run",
        "--allow-parallel-runners",
        "--enable-only",
        "forbidigo",
        "./{package_rel}/..."
      ]
    },
    "errcheck": {
      "requires": [
        "modules/.golangci.yml"
      ],
      "workdir": "{module_dir}",
      "command": [
        "{golangci_lint}",
        "run",
        "--allow-parallel-runners",
        "--enable-only",
        "errcheck",
        "./{package_rel}/..."
      ]
    },
    "go-build-tags": {
      "requires": [
        "modules/.golangci.yml",
        "scripts/check-go-build-tags.sh"
      ],
      "workdir": ".",
      "command": [
        "./scripts/check-go-build-tags.sh"
      ]
    },
    "jwt-audience": {
      "requires": [
        "scripts/check-jwt-audience-tests.py"
      ],
      "workdir": ".",
      "command": [
        "uv",
        "run",
        "--no-project",
        "python",
        "scripts/check-jwt-audience-tests.py"
      ]
    },
    "eslint-kit": {
      "requires": [
        "modules/kit/eslint.config.js"
      ],
      "workdir": "modules/kit",
      "command": [
        "npx",
        "--no-install",
        "eslint",
        "--no-warn-ignored",
        "{path}"
      ]
    },
    "eslint-web": {
      "requires": [
        "modules/apps/web/eslint.config.js"
      ],
      "workdir": "modules/apps/web",
      "command": [
        "npx",
        "--no-install",
        "eslint",
        "--no-warn-ignored",
        "{path}"
      ]
    }
  },
