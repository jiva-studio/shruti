# CouchDB source (existing Lectorium content store).
# The production CouchDB runs at couchdb.shruti.app (the
# `shruti.app` domain is the current public alias; the old
# `lectorium.dev` certs expired). Credentials come from the service's
# docker-compose — `lectorium:lectorium` is the default.
COUCHDB_URL=https://couchdb.shruti.app
COUCHDB_USER=lectorium
COUCHDB_PASSWORD=lectorium

# Target AWS S3 bucket — the ONLY upload target in this phase.
# Yandex Object Storage mirror will be set up later as a separate
# one-shot rclone sync. Do not wire it back into this tool — keep a
# single source of truth while content ingestion stabilises.
S3_AWS_BUCKET=akds-lectorium
S3_AWS_REGION=us-east-1
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
