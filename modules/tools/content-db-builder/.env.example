# CouchDB source (existing Shruti content store)
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# Target AWS S3 bucket
S3_AWS_BUCKET=shruti-engine
S3_AWS_REGION=us-east-1
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=

# Target Yandex Object Storage bucket (optional mirror)
S3_YANDEX_BUCKET=shruti-engine
S3_YANDEX_ENDPOINT=https://storage.yandexcloud.net
S3_YANDEX_ACCESS_KEY_ID=
S3_YANDEX_SECRET_ACCESS_KEY=
