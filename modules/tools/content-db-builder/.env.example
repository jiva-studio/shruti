# CouchDB source (existing Lectorium content store).
# Production runs at couchdb.shruti.app (the old `lectorium.dev`
# TLS cert expired — `shruti.app` is the current public alias).
#
# The `dictionary`, `tracks`, and `transcripts` databases allow
# ANONYMOUS read access, so you can leave USER/PASSWORD empty for this
# tool. If the admin password for this instance is rotated, fill them
# in — `lectorium:lectorium` in the old docker-compose was the
# service-account name, NOT the admin password.
COUCHDB_URL=https://couchdb.shruti.app
COUCHDB_USER=
COUCHDB_PASSWORD=

# Wasabi source (legacy media bucket — audio + transcripts + artifacts
# under `library/tracks/{trackId}/...`). Used by `migrate-media` to
# copy objects to AWS + Yandex under the new id-prefixed layout.
S3_WASABI_BUCKET=
S3_WASABI_REGION=us-east-1
S3_WASABI_ENDPOINT=
S3_WASABI_ACCESS_KEY_ID=
S3_WASABI_SECRET_ACCESS_KEY=

# AWS target — primary destination bucket.
# Credentials may be left empty: when both keys are unset, the SDK
# falls back to its default chain (env / shared config / SSO / IMDS),
# which is the right path for `aws sso login` workflows.
S3_AWS_BUCKET=akds-lectorium
S3_AWS_REGION=us-east-1
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=

# Yandex Object Storage mirror — second destination, S3-compatible.
# Set S3_YANDEX_BUCKET to enable; if unset, all upload steps target
# AWS only. Yandex requires explicit creds (no instance metadata).
S3_YANDEX_BUCKET=
S3_YANDEX_REGION=ru-central1
S3_YANDEX_ENDPOINT=https://storage.yandexcloud.net
S3_YANDEX_ACCESS_KEY_ID=
S3_YANDEX_SECRET_ACCESS_KEY=
