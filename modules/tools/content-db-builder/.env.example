# CouchDB source (existing Shruti content store).
# Production runs at couchdb.shruti.local (the old `shruti.dev`
# TLS cert expired — `shruti.app` is the current public alias).
#
# The `dictionary`, `tracks`, and `transcripts` databases allow
# ANONYMOUS read access, so you can leave USER/PASSWORD empty for this
# tool. If the admin password for this instance is rotated, fill them
# in — `shruti:shruti` in the old docker-compose was the
# service-account name, NOT the admin password.
COUCHDB_URL=https://couchdb.shruti.local
COUCHDB_USER=
COUCHDB_PASSWORD=

# Target AWS S3 bucket — the ONLY upload target in this phase.
# Yandex Object Storage mirror will be set up later as a separate
# one-shot rclone sync. Do not wire it back into this tool — keep a
# single source of truth while content ingestion stabilises.
S3_AWS_BUCKET=shruti-engine
S3_AWS_REGION=us-east-1
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
