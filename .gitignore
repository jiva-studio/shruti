# ---------------------------------------------------------------------------- #
#                                  Chat evals                                  #
# ---------------------------------------------------------------------------- #

# Output of `tests/evals/run_chunk_tools_eval.py` — regenerated on every run.
# chunk_tools.jsonl is the source-of-truth test cases file; everything else is artefact.
modules/services/chat/app/tests/evals/*.jsonl
!modules/services/chat/app/tests/evals/chunk_tools.jsonl

# ---------------------------------------------------------------------------- #
#                                Observability                                 #
# ---------------------------------------------------------------------------- #

# Real secrets — only the .example variant is tracked.
infra/observability/config/shared.env
infra/observability/secrets/*
!infra/observability/secrets/.gitkeep

# Rendered templates (output is regenerated by deploy.sh)
infra/observability/compose/Caddyfile
infra/observability/compose/prometheus.yml
infra/observability/compose/grafana/provisioning/datasources/datasources.yml

# Runtime .env synthesised on the host during deploy
infra/observability/compose/.env