{
  "folders": [
    {
      "name": "💾 Lectorium :: GitHub",
      "path": "./.github"
    },
    {
      "name": "📱 Apps :: Mobile",
      "path": "./modules/apps/mobile"
    },
    {
      "name": "📀 Libraries :: Domain",
      "path": "./modules/libs/domain"
    },
    {
      "name": "📀 Libraries :: Application",
      "path": "./modules/libs/application"
    },
    {
      "name": "📀 Libraries :: Persistence",
      "path": "./modules/libs/persistence"
    },
    {
      "name": "📀 Libraries :: Audio Player",
      "path": "./modules/libs/audioPlayer"
    },
    {
      "name": "🍪 Tools :: Content DB Builder",
      "path": "./modules/tools/content-db-builder"
    },
    {
      "name": "📖 Docs",
      "path": "./docs"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "👷 Audio Player Plugin :: Build",
        "detail": "Build the audio player plugin",
        "command": "npm",
        "type": "shell",
        "args": ["run", "build"],
        "presentation": { "reveal": "always" },
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:📀 Libraries :: Audio Player}"
        }
      },
      {
        "label": "👷 Mobile :: Build",
        "detail": "Build the mobile app + sync Capacitor",
        "command": "npm",
        "type": "shell",
        "args": ["run", "build+sync"],
        "presentation": { "reveal": "silent" },
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:📱 Apps :: Mobile}"
        }
      },
      {
        "label": "🧪 Mobile :: Test",
        "detail": "Run vitest unit tests",
        "command": "npm",
        "type": "shell",
        "args": ["test"],
        "presentation": { "reveal": "always" },
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:📱 Apps :: Mobile}"
        }
      }
    ]
  },
  "settings": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "eslint.validate": ["javascript", "typescript", "vue"],
    "volar.takeOverMode.enabled": true,
    "vue.language-server.runtime": "node",
    "search.exclude": {
      "**/dist/**": true,
      "**/node_modules/**": true,
      "**/.vite/**": true,
      "**/.git/**": true
    },
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/dist": true,
      "**/node_modules": true,
      "**/.vite": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/dist/**": true,
      "**/node_modules/**": true
    }
  }
}
