{
  "folders": [
    {
      "name": "💾 Shruti :: Data",
      "path": "./data"
    },
    {
      "name": "💨 Services :: Airflow",
      "path": "./modules/services/airflow"
    },
    {
      "name": "📦 Services :: Minio",
      "path": "./modules/services/minio"
    },
    {
      "name": "🚪 Services :: Gateway",
      "path": "./modules/services/gateway"
    },
    {
      "name": "🚪 Services :: Database",
      "path": "./modules/services/database"
    },
    {
      "name": "👋 Apps :: Landing",
      "path": "./modules/apps/landing"
    },
    {
      "name": "📜 Misc :: Scripts",
      "path": "./scripts"
    },
    {
      "name": "📖 Docs",
      "path": "./docs"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🚀 Airflow :: Run",
        "detail": "Run Airflow service",
        "command": "source ./.airflow/bin/activate.fish && airflow standalone",
        "type": "shell",
        "args": [],
        "presentation": {
          "reveal": "always"
        },
        "icon": {
          "id": "flame"
        },
        "problemMatcher": [],
        "group": "none",
        "isBackground": true,
        "options": {
          "cwd": "/workspaces/shruti/modules/services/airflow",
          "env": {
            "AIRFLOW_HOME": "/workspaces/shruti/data/airflow",
            "AIRFLOW__CORE__MP_START_METHOD": "spawn"
          }
        }
      },
      {
        "label": "🚀 Minio :: Run",
        "detail": "Run Minio service",
        "command": "minio",
        "type": "shell",
        "args": [
          "server",
          "/workspaces/shruti/data/minio/storage",
          "--console-address", "':9001'",
          "--certs-dir", "/workspaces/shruti/data/minio/certs"
        ],
        "presentation": {
          "reveal": "always"
        },
        "icon": {
          "id": "flame"
        },
        "problemMatcher": [],
        "group": "none",
        "isBackground": true,
        "options": {
          "cwd": "/workspaces/shruti/modules/services/airflow",
          "env": {
            "MINIO_ROOT_USER": "shruti",
            "MINIO_ROOT_PASSWORD": "shruti",
          }
        }
      },
      {
        "label": "🚀 Gateway :: Run",
        "detail": "Run Gateway service",
        "command": "nginx",
        "type": "shell",
        "args": [
          "-c", "/workspaces/shruti/modules/services/gateway/nginx.conf",
          "-g", "'daemon off;'"
        ],
        "presentation": {
          "reveal": "always"
        },
        "icon": {
          "id": "flame"
        },
        "problemMatcher": [],
        "group": "none",
        "isBackground": true,
        "options": {
          "cwd": "/workspaces/shruti/modules/services/gateway",
        }
      },
      {
        "label": "🚀 Postgres :: Run",
        "detail": "Run the database",
        "command": "sudo service postgresql start",
        "type": "shell",
        "args": [],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always"
        },
        "icon": {
          "id": "flame"
        },
        "group": "none",
        "isBackground": true,
      },
      {
        "label": "🚀 Run All",
        "dependsOn": [
          "🚀 Postgres :: Run",
          "🚀 Airflow :: Run",
          "🚀 Gateway :: Run",
        ],
        "dependsOrder": "parallel"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [],
    "compounds": []
  },
  "settings": {
    /* -------------------------------------------------------------------------- */
    /*                                   editor                                   */
    /* -------------------------------------------------------------------------- */
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    /* -------------------------------------------------------------------------- */
    /*                                   linter                                   */
    /* -------------------------------------------------------------------------- */
    "eslint.validate": [
      "javascript",
      "typescript",
      "vue"
    ],
    /* -------------------------------------------------------------------------- */
    /*                                    tests                                   */
    /* -------------------------------------------------------------------------- */
    "jest.enable": false,
    "jest.jestCommandLine": "npx jest",
    "jest.runMode": "on-demand",
    "jestrunner.jestCommand": "npx jest",
    /* -------------------------------------------------------------------------- */
    /*                                 file types                                 */
    /* -------------------------------------------------------------------------- */
    "[feature]": {
      "editor.formatOnType": true,
      "editor.formatOnSave": true,
    },
    "typescript.preferences.autoImportFileExcludePatterns": [
      "**/dist/**",
    ],
    /* -------------------------------------------------------------------------- */
    /*                                   github                                   */
    /* -------------------------------------------------------------------------- */
    "githubIssues.issueBranchTitle": "${user}/issue-${issueNumber}-${sanitizedIssueTitle}",
    /* -------------------------------------------------------------------------- */
    /*                                   search                                   */
    /* -------------------------------------------------------------------------- */
    "search.exclude": {
      "**/dist/**": true,
      "**/.airflow/**": true,
    },
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/dist": true,
      "**/node_modules": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/.hg/store/**": true,
      "**/dist/**": true,
      "**/node_modules/**": true
    },
  },
}
