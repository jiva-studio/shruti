{
  "mcpServers": {
    "shruti": {
      "type": "http",
      "url": "http://127.0.0.1:8081/mcp"
    },
    "shruti-search": {
      "type": "http",
      "url": "http://shruti-prod-eu:8086/mcp"
    },
    "transcriber": {
      "type": "http",
      "url": "http://mac-host:8090/mcp"
    },
    "denoiser": {
      "type": "http",
      "url": "http://mac-host:8092/mcp"
    },
    "claude-context": {
      "command": "npx",
      "args": ["-y", "-p", "@zilliz/claude-context-mcp@latest", "-p", "ajv", "-p", "ajv-formats", "claude-context-mcp"],
      "env": {
        "EMBEDDING_PROVIDER": "Ollama",
        "EMBEDDING_MODEL": "code-embed",
        "EMBEDDING_DIMENSION": "768",
        "EMBEDDING_BATCH_SIZE": "64",
        "OLLAMA_HOST": "http://mac-host:11434",
        "OLLAMA_REQUEST_TIMEOUT": "300000",
        "MILVUS_ADDRESS": "mac-host:19531",
        "CODE_CHUNKS_COLLECTION_NAME_OVERRIDE": "shruti"
      }
    }
  }
}
