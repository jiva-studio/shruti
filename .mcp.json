{
  "mcpServers": {
    "shruti": {
      "type": "http",
      "url": "http://127.0.0.1:8081/mcp"
    },
    "shruti-search": {
      "type": "http",
      "url": "http://shruti-prod-eu:8086/mcp"
    },
    "transcriber": {
      "command": "/home/akd/Projects/akdasa-studios/shruti/source/shruti/modules/tools/transcriber-mcp/bin/transcriber-mcp",
      "args": ["-stdio", "-service-url", "http://192.168.0.17:8080"]
    },
    "denoiser": {
      "command": "/home/akd/.local/bin/denoiser-mcp",
      "args": ["-stdio", "-service-url", "http://192.168.0.17:8091"]
    },
    "claude-context": {
      "command": "npx",
      "args": ["-y", "-p", "@zilliz/claude-context-mcp@latest", "-p", "ajv", "-p", "ajv-formats", "claude-context-mcp"],
      "env": {
        "EMBEDDING_PROVIDER": "Ollama",
        "EMBEDDING_MODEL": "code-embed",
        "EMBEDDING_DIMENSION": "768",
        "EMBEDDING_BATCH_SIZE": "64",
        "OLLAMA_HOST": "http://192.168.0.17:11434",
        "OLLAMA_REQUEST_TIMEOUT": "300000",
        "MILVUS_ADDRESS": "192.168.0.17:19531",
        "CODE_CHUNKS_COLLECTION_NAME_OVERRIDE": "shruti"
      }
    }
  }
}
