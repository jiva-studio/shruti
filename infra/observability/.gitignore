# infra/observability/.gitignore
#
# Anything containing credentials lives outside of git.

# Real secrets — only the .example variant is tracked.
config/shared.env
secrets/*
!secrets/.gitkeep

# Rendered templates (output is regenerated by deploy.sh, never edited).
compose/Caddyfile
compose/prometheus.yml
compose/grafana/provisioning/datasources/datasources.yml

# Runtime .env synthesised on the host
compose/.env

# Misc local
*.local.env
*.bak
compose/grafana/provisioning/alerting/contact-points.yml
