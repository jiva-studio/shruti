# infra/observability/config/shared.env.example
#
# Copy to config/shared.env (gitignored) and fill in real secrets before
# running ./scripts/deploy.sh. The deploy script sources this file in
# addition to config/<region>.env.

# ── Cloudflare ────────────────────────────────────────────────────
# Token scope: Zone → DNS → Edit, restricted to akdasa.studio.
# Create at https://dash.cloudflare.com/profile/api-tokens (Edit zone DNS template).
CF_API_TOKEN=changeme-cf-token

# Cloudflare zone identifier for akdasa.studio (UI → Overview → API → Zone ID).
CF_ZONE_ID=changeme-zone-id

# ── Telegram bot for alerts ───────────────────────────────────────
# Create via @BotFather → /newbot → save the token.
# Then send any message to the bot and grab chat_id via:
#   curl -s "https://api.telegram.org/bot${TG_BOT_TOKEN}/getUpdates" \
#     | jq '.result[].message.chat.id'
TG_BOT_TOKEN=changeme-telegram-token
TG_CHAT_ID=changeme-chat-id

# ── Grafana admin (first-boot password) ───────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme-strong-grafana-password

# ── Langfuse bootstrap admin (LANGFUSE_INIT_USER_*) ───────────────
# Email lives in config/<region>.env (non-secret). Password here:
LANGFUSE_INIT_USER_PASSWORD=changeme-strong-langfuse-password

# ── MinIO root credentials ────────────────────────────────────────
MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD — generated on host by ensure_secrets, NOT here

# ── Tailscale auth key (for tailscale-bootstrap.sh) ───────────────
# Optional — only needed if you let deploy.sh install Tailscale itself.
# Reusable + pre-approved + tagged "tag:lectorium-obs" (or tag:lectorium-prod-eu).
TAILSCALE_AUTHKEY=
