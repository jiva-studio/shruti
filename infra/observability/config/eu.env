# infra/observability/config/eu.env
#
# Per-region config for the EU obs stack. Versioned in git — contains no
# secrets, only public-shape values + placeholders that the operator
# replaces with the real Tailscale IPs once both hosts are provisioned.
#
# Secrets live in config/shared.env (gitignored) or under secrets/.

REGION=eu

# DNS / wildcard domain (matches Cloudflare zone akdasa.studio)
TAILNET_DOMAIN=obs.eu.lectorium.akdasa.studio

# Tailscale IPs — fill in after `tailscale ip -4` on each host
OBS_TS_IP=100.82.99.38
PROD_HOST_TS_IP=100.71.11.107

# Langfuse bootstrap user (created on first start via LANGFUSE_INIT_USER_*)
LANGFUSE_INIT_USER_EMAIL=admin@akdasa.studio
LANGFUSE_INIT_USER_NAME=admin
