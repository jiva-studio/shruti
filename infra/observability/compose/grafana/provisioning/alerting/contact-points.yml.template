# Single Telegram channel — three severities funnel into the same chat,
# differentiated by emoji + the matcher-driven policies in policies.yml.
#
# TG_BOT_TOKEN and TG_CHAT_ID rendered by envsubst at deploy time.

apiVersion: 1

contactPoints:
  - orgId: 1
    name: telegram-main
    receivers:
      - uid: telegram-main
        type: telegram
        settings:
          bottoken: $TG_BOT_TOKEN
          chatid: "$TG_CHAT_ID"
          parse_mode: HTML
        disableResolveMessage: false
