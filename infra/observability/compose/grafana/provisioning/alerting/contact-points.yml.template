# infra/observability/compose/grafana/provisioning/alerting/contact-points.yml
#
# Single Telegram channel — three severities funnel into the same chat,
# differentiated by emoji + the matcher-driven policies in policies.yml.
#
# TG_BOT_TOKEN and TG_CHAT_ID come from the Grafana container env, sourced
# from secrets/ at deploy time (see scripts/deploy.sh).

apiVersion: 1

contactPoints:
  - orgId: 1
    name: telegram-main
    receivers:
      - uid: telegram-main
        type: telegram
        settings:
          bottoken: $TG_BOT_TOKEN
          chatid: "$TG_CHAT_ID"
          parse_mode: HTML
          message: |
            {{ template "telegram.message" . }}
        disableResolveMessage: false

templates:
  - orgId: 1
    name: telegram.message
    template: |
      {{ define "telegram.message" -}}
      {{ range .Alerts -}}
      {{ if eq .Status "firing" -}}
      {{ if eq .Labels.severity "P1" }}🔴{{ else if eq .Labels.severity "P2" }}🟠{{ else }}🟡{{ end }}
      {{- else -}}✅{{- end }} <b>[{{ .Labels.severity }}] {{ .Labels.alertname }}</b>
      Service: {{ .Labels.service | default "—" }}
      Host: {{ .Labels.host | default .Labels.instance | default "—" }}
      Value: {{ .Annotations.value | default .ValueString }}
      {{ .Annotations.summary }}
      {{ if .Annotations.dashboard_url -}}Dashboard: {{ .Annotations.dashboard_url }}{{- end }}
      {{ if .Annotations.runbook_url -}}Runbook: {{ .Annotations.runbook_url }}{{- end }}
      {{ end -}}
      {{- end }}
