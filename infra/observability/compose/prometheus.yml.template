# infra/observability/compose/prometheus.yml.template
#
# Rendered by infra/shared/lib/render-templates.sh with ${PROD_HOST_TS_IP}
# substituted from config/<region>.env. Exporters on prod-EU bind on the
# Tailscale IP, so the scrape URLs use the Tailscale 100.x.x.x network.
#
# `obs` self-scrape goes through the Tailscale interface too — node-exporter
# and cAdvisor on the obs host bind on ${OBS_TS_IP} (see docker-compose.yml).
# This keeps the topology symmetric with the prod-EU agent.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: lectorium-eu
    region: ${REGION}

# Alertmanager wiring: Grafana provisions alerts directly via the unified
# alerting engine, so Prometheus only ships scrapes to it via remote_write
# would be overkill. Grafana datasources point at this Prometheus.

scrape_configs:
  # ── prod-EU side ──────────────────────────────────────────────────
  - job_name: node-prod-eu
    static_configs:
      - targets: ['${PROD_HOST_TS_IP}:9100']
        labels: { host: prod-eu }

  - job_name: cadvisor-prod-eu
    static_configs:
      - targets: ['${PROD_HOST_TS_IP}:8090']
        labels: { host: prod-eu }

  - job_name: postgres-prod-eu
    static_configs:
      - targets: ['${PROD_HOST_TS_IP}:9187']
        labels: { host: prod-eu, db: lectorium }

  # Second exporter: the orchestrator has its own Postgres instance, so its
  # job/outbox tables are unreachable from the `postgres-prod-eu` connection.
  - job_name: orchestrator-postgres-prod-eu
    static_configs:
      - targets: ['${PROD_HOST_TS_IP}:9188']
        labels: { host: prod-eu, db: orchestrator }

  - job_name: redis-prod-eu
    static_configs:
      - targets: ['${PROD_HOST_TS_IP}:9121']
        labels: { host: prod-eu, instance_kind: chat-redis }

  - job_name: blackbox-prod-eu
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://chat:8080/healthz
          - http://auth:8081/auth/healthz
          - http://share-audio:8082/healthz
          - http://share-video:8083/healthz
          - http://orchestrator:8086/healthz
          - http://ingest:8088/healthz
          # storage-sync exposes /readyz, not just /healthz: it reports stale
          # once no full mirror pass has succeeded for three intervals, which is
          # the failure worth paging on (a live process with a rotting mirror).
          - http://storage-sync:8089/readyz
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ${PROD_HOST_TS_IP}:9115

  # Public edge probe — goes THROUGH caddy (https + 443), unlike blackbox-prod-eu
  # which hits the service ports directly and stays green when only the reverse
  # proxy is down. http_2xx validates the TLS cert too, so this also feeds
  # probe_ssl_earliest_cert_expiry for the public cert (tls_cert_expiring_soon).
  - job_name: blackbox-edge
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://${LECTORIUM_DOMAIN}/healthz
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ${PROD_HOST_TS_IP}:9115

  - job_name: promtail-prod-eu
    static_configs:
      - targets: ['${PROD_HOST_TS_IP}:9080']
        labels: { host: prod-eu }

  # ── obs self side ─────────────────────────────────────────────────
  - job_name: node-obs
    static_configs:
      - targets: ['${OBS_TS_IP}:9100']
        labels: { host: obs }

  - job_name: cadvisor-obs
    static_configs:
      - targets: ['${OBS_TS_IP}:8090']
        labels: { host: obs }

  - job_name: prometheus-self
    static_configs:
      - targets: ['localhost:9090']

  - job_name: loki-self
    static_configs:
      - targets: ['loki:3100']
    metrics_path: /metrics

  - job_name: promtail-obs
    static_configs:
      - targets: ['promtail:9080']
        labels: { host: obs }
