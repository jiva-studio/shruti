# observability-agent — runtime env for prod-EU collectors.
#
# Copied to the host as /opt/lectorium-obs-agent/.env by scripts/deploy.sh
# at deploy time. Do not commit a populated copy of this file.

# Tailscale IP of THIS host (prod-eu). Exporters bind on it so they're
# reachable only through the Tailnet, never on the host's public IP.
# Get it via: tailscale ip -4
PROD_EU_TS_IP=100.x.x.A

# Tailscale IP of the obs host. Promtail pushes logs to this address on
# port 3100 (Loki).
OBS_TS_IP=100.x.x.B

# Password for the `pg_exporter` Postgres role. Must match what was set
# on the live chat-Postgres — see README.md "Postgres bootstrap" section
# for both fresh-volume and existing-volume paths.
PG_EXPORTER_PASSWORD=CHANGE_ME_long_random_string
