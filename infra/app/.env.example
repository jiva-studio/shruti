# Template for infra/.env (for local dev) and /opt/lectorium/.env (on the
# production VPS). The operator places the real file by hand — deploy.sh
# does NOT generate or copy secrets.
#
# All vars are LECTORIUM_-prefixed; docker-compose.yml translates each
# into the variable name the underlying image expects (POSTGRES_PASSWORD,
# DOMAIN, etc.) at container startup.

# ── Deployment environment ──────────────────────────────────────────
# Tag every log line for Datadog tag-from-log pipelines. Acceptable
# values: dev | staging | prod. Local docker-compose.dev.yml stack
# leaves this blank and inherits the "dev" default from base compose.
LECTORIUM_ENV=prod

# ── Region role (deployment shape, per host) ────────────────────────
# Picked per host:
#   origin = full backend (auth/chat/cleanup-worker run here)
#   proxy  = thin reverse-proxy + share-audio/share-video only.
#            Caddy forwards /auth/* + chat surface to LECTORIUM_GLOBAL_HOST
#            with X-Lectorium-Region: ru injected.
# deploy.sh reads this if --role isn't passed on the CLI. Also drives
# COMPOSE_PROFILES (must stay in sync — deploy.sh sets it for you).
LECTORIUM_REGION_ROLE=origin
COMPOSE_PROFILES=origin

# Only set on proxy hosts — the public origin URL Caddy reverse-proxies
# chat/auth traffic to. No scheme, no path. Required when
# COMPOSE_PROFILES=proxy; leave blank on origin.
LECTORIUM_GLOBAL_HOST=

# Comma-separated list of IP/CIDR sources allowed to set X-Lectorium-Region.
# On the global host, this is the RU proxy's public egress IP — without it,
# the chat service silently drops the region tag because the peer (after
# the trusted XFF rewrite) is a public IP, not loopback / RFC1918.
# Also concatenated into TRUSTED_PROXY_CIDRS inside compose so the same
# IP unlocks ProxyHeadersMiddleware. Empty in dev / single-region.
# REGION_HEADER_TRUSTED_SOURCES=62.109.31.177/32
LECTORIUM_REGION_HEADER_TRUSTED_SOURCES=

# ── Caddy edge ──────────────────────────────────────────────────────
# Caddy host. <ip-dashed>.sslip.io works without owning a domain.
LECTORIUM_DOMAIN=
LECTORIUM_ACME_EMAIL=
# Public hostname for the corpus-mcp MCP endpoint — its own subdomain,
# serving /mcp at root (e.g. mcp.shruti.app). Needs a DNS A record
# → this host; Caddy then auto-issues Let's Encrypt. Leave empty on hosts
# that don't serve it (defaults to internal :8089, no ACME).
LECTORIUM_MCP_DOMAIN=

# ── Image registry + tags ───────────────────────────────────────────
# Default ghcr.io location. Override on a per-service basis when rolling
# out a branch build or pinning to a specific :main-<sha> for rollback.
LECTORIUM_REGISTRY=ghcr.io/jiva-studio
LECTORIUM_AUTH_TAG=latest
LECTORIUM_CHAT_TAG=latest
LECTORIUM_SHARE_AUDIO_TAG=latest
LECTORIUM_SHARE_VIDEO_TAG=latest
LECTORIUM_SHARE_TRANSCRIPT_TAG=latest
LECTORIUM_CORPUS_MCP_TAG=latest
LECTORIUM_PROFILE_TAG=latest
LECTORIUM_ORCHESTRATOR_TAG=latest
LECTORIUM_CADDY_TAG=latest

# ── Postgres ────────────────────────────────────────────────────────
# Postgres role password — generate locally with:
#   head -c 24 /dev/urandom | base64 | tr -d '/+='
LECTORIUM_POSTGRES_PASSWORD=
# profile sync service's OWN Postgres (separate DB from the shared one).
# Generate the same way as the role password above (head -c 24 /dev/urandom
# | base64 | tr -d '/+='); gen-dev-env.sh fills it for local dev. profile
# refuses to start if it's missing.
LECTORIUM_PROFILE_POSTGRES_PASSWORD=
# orchestrator service's OWN Postgres (its job store — separate DB from both
# the shared one and profile's). Generate the same way as the role password
# above (head -c 24 /dev/urandom | base64 | tr -d '/+='); gen-dev-env.sh fills
# it for local dev. The orchestrator refuses to start if it's missing.
LECTORIUM_ORCHESTRATOR_POSTGRES_PASSWORD=

# ── discovery (origin only, INTERNAL) ───────────────────────────────
# An index of lecture audio published on external archives. It owns its own
# Postgres, which must be a pgvector image. Generate the password the same way
# as the ones above; gen-dev-env.sh fills it for local dev.
LECTORIUM_DISCOVERY_POSTGRES_PASSWORD=
# The scheduler is the ONLY thing that crawls on its own, and it is off.
# Starting the container must not touch anybody's website; explicit single-URL
# requests and manual source runs work regardless of this flag.
LECTORIUM_DISCOVERY_SCHEDULER_ENABLED=false
LECTORIUM_DISCOVERY_SCHEDULER_WORKERS=4
# Only one replica crawls: the per-host gap and the circuit breaker live in one
# process's memory, so a second crawler is a second rate limiter and twice the
# agreed request rate at somebody else's site. The others still serve the API.
#
# One page end to end. Every step below has its own timeout and they stack.
LECTORIUM_DISCOVERY_PAGE_TIMEOUT=10m
# The connection pool, shared between crawl workers and HTTP handlers. Raised
# automatically if it would be smaller than the worker count.
LECTORIUM_DISCOVERY_DB_MAX_CONNS=16
# Identify ourselves to the archives we read, with somewhere to complain to.
# These are volunteer projects paying their own bandwidth bills.
LECTORIUM_DISCOVERY_USER_AGENT=LectoriumDiscovery/1.0 (+https://shruti.app/about)
LECTORIUM_DISCOVERY_CRAWL_DELAY=1s
# One outbound request, and the most of a response we will read (8 MiB).
LECTORIUM_DISCOVERY_REQUEST_TIMEOUT=30s
LECTORIUM_DISCOVERY_MAX_BODY_BYTES=8388608
# Needed for sources a datacenter address cannot read; YouTube answers one with
# a bot check. Empty reads from the host itself.
LECTORIUM_DISCOVERY_PROXY=
# Normalization and embeddings both go through OPENROUTER_API_KEY below.
LECTORIUM_DISCOVERY_LLM_BASE_URL=https://openrouter.ai/api/v1
LECTORIUM_DISCOVERY_LLM_MODEL=google/gemini-3.1-flash-lite
# Same model and dimension as the corpus, so the vectors stay comparable.
LECTORIUM_DISCOVERY_EMBED_MODEL=openai/text-embedding-3-small
LECTORIUM_DISCOVERY_EMBED_DIM=1536

# ── Stream broker (personal-library event streams) ──────────────────
# Dedicated Redis-Streams instance (compose service `redis-streams`) — a
# SEPARATE process from the cache `redis` above, because stream entries have
# no TTL and would OOM the cache's volatile-lru instance. Consumed by the
# orchestrator, chat, and profile services via XADD/XREADGROUP. The value is
# fixed to the in-network service name; it only needs setting here to point at
# an external broker. See modules/services/README-streams.md for the stream
# names, consumer-group conventions, and the MAXLEN/XACK/outbox contract.
STREAMS_REDIS_URL=redis://redis-streams:6379/0

# ── Orchestrator (personal-library ingest pipeline, origin only) ────
# Generic job orchestrator; first scenario is personal-library ingest
# (fetch -> transcribe -> review -> store -> emit track.events). Owns its OWN
# Postgres (LECTORIUM_ORCHESTRATOR_POSTGRES_PASSWORD above) and the
# redis-streams broker (STREAMS_REDIS_URL above). Image tag is
# LECTORIUM_ORCHESTRATOR_TAG above.
# Deepgram API key for the transcribe stage — from console.deepgram.com.
# Unset → the transcribe stage is inert (service still boots + serves /healthz).
LECTORIUM_DEEPGRAM_API_KEY=
# Outbound proxy URL for yt-dlp source fetches (geo / rate shaping), e.g.
# http://user:pass@host:port or socks5://host:port. Empty → direct egress.
LECTORIUM_YTDLP_PROXY=

# ── Auth provider audiences (public, baked into mobile APK/.ipa) ────
LECTORIUM_GOOGLE_CLIENT_IDS=315690032552-hn1sgjk1m7fn38q41pupavep7idpnqoq.apps.googleusercontent.com,315690032552-l2vl1h7qqdidpnem255ng6v04j3icq47.apps.googleusercontent.com
LECTORIUM_APPLE_BUNDLE_IDS=studio.jiva.shruti

# ── Billing (Paymento crypto checkout → RC promotional "pro") ───────
# Merchant API key + IPN HMAC secret from app.paymento.io (Settings → API).
# Unset → billing /checkout and /webhooks/paymento return 503 (service
# still boots). Origin host only; the RU proxy forwards /billing/* here.
LECTORIUM_PAYMENTO_API_KEY=
LECTORIUM_PAYMENTO_HMAC_SECRET=
# Optional override; defaults to https://api.paymento.io in compose.
LECTORIUM_PAYMENTO_BASE_URL=
# Site origin used to build Paymento ReturnUrl; defaults to the live site.
LECTORIUM_BILLING_PUBLIC_BASE_URL=
# Shared service-to-service secret: billing → auth /internal/subscription/grant.
# Set the SAME value for both services. Unset → the grant endpoint is 404
# and crypto payments can't activate PRO. Generate like the PG password.
LECTORIUM_INTERNAL_API_TOKEN=

# ── Email sign-in (passwordless OTP) ────────────────────────────────
# SMTP transport for one-time sign-in codes. Works with AWS SES SMTP
# credentials (Host e.g. email-smtp.us-east-1.amazonaws.com, port 587) or
# any SMTP server. SMTP_HOST or EMAIL_FROM unset → the email-OTP endpoints
# return 503 (auth still boots); in dev the code is logged, not mailed.
# The sender identity (EMAIL_FROM domain/address) must be verified in SES,
# and the account out of the SES sandbox, for delivery to arbitrary inboxes.
LECTORIUM_SMTP_HOST=
LECTORIUM_SMTP_PORT=587
LECTORIUM_SMTP_USERNAME=
LECTORIUM_SMTP_PASSWORD=
LECTORIUM_EMAIL_FROM=Shruti <no-reply@shruti.app>

# ── Chat-service ────────────────────────────────────────────────────
OPENROUTER_API_KEY=
APP_SHARED_TOKEN=

# ── corpus-mcp (origin only, PUBLIC) ────────────────────────────────
# Public read-only MCP over the canonical corpus (shlokas + lectures).
# It replaces the retired search-mcp. NOT published on a host port —
# Caddy reverse-proxies the public /corpus/* route to it. Image tag is
# LECTORIUM_CORPUS_MCP_TAG above.
# corpus-mcp embeds the query with the SAME model the chat indexer used,
# or query vectors land in a different space. Leave these unset to inherit
# chat's defaults (text-embedding-3-small / dim 1536); only set them if
# chat's own EMBED_* are overridden. Reuses OPENROUTER_API_KEY above.
# EMBED_PROVIDER=openrouter
# EMBED_MODEL=openai/text-embedding-3-small
# EMBED_DIM=1536
# It self-fetches the current.db + library.db SQLite artifacts from the
# Bunny pull zone. The base URL is LECTORIUM_MEDIA_BASE_URL (reused from
# the chat/share-* services; defaults to the b-cdn pull zone in compose,
# so it only needs setting here to override that default).
# LECTORIUM_MEDIA_BASE_URL=https://akds-lectorium.b-cdn.net
#
# Legacy: LECTORIUM_TS_IP was search-mcp's tailscale publish IP. No app
# service uses it anymore (corpus-mcp is Caddy-fronted, not tailnet-bound);
# it is retained only because the e2e live-stack scripts still default it.
LECTORIUM_TS_IP=

# ── Reranker (cross-encoder) ──
# Default-on, but a missing VOYAGE_API_KEY degrades the chat service to
# the bi-encoder cosine path (warns at startup). Set RERANK_PROVIDER=none
# to disable explicitly.
RERANK_PROVIDER=voyage
VOYAGE_API_KEY=

# ── S3 (chat, share-audio, share-video, backup.sh) ──────────────────
# Recommended: separate IAM users per service with scoped policies — see
# infra/README.md for the exact policy JSON. The keys below are
# read by EVERY container that talks to S3; for finer separation put
# the service-specific keys in /opt/lectorium/<service>.env and adjust
# compose env_file paths.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# S3 endpoint override (set on RU proxy to point share-audio + share-video
# at Yandex Object Storage; leave blank on origin to use AWS default).
# LECTORIUM_S3_ENDPOINT_URL=https://storage.yandexcloud.net
# Public CDN host for share-audio + share-video output. Required whenever
# LECTORIUM_S3_ENDPOINT_URL is set — otherwise share-* build virtual-host
# AWS URLs for files that live on the alternate endpoint and the mobile
# client cannot play / share them. RU example:
# LECTORIUM_S3_PUBLIC_BASE=https://akds-lectorium.storage.yandexcloud.net
# S3 bucket name shared by chat, share-audio, share-video, and backups.
LECTORIUM_S3_BUCKET=akds-lectorium
# Per-feature key prefixes. Defaults match the live bucket layout.
LECTORIUM_S3_EXCERPTS_PREFIX=public/shares/audio
LECTORIUM_S3_BACKGROUNDS_PREFIX=private/share/video/backgrounds
LECTORIUM_S3_VIDEO_PREFIX=public/share/video

# ── Object storage (Bunny Edge Storage) ───────────────────────────────────
# Shared by share-audio, share-video and storage-sync. Zone + password
# (storage-zone key, NOT the account API key).
LECTORIUM_STORAGE_ZONE=akds-lectorium-eu
LECTORIUM_STORAGE_KEY=
# Backend for share-audio / share-video writes: "s3" (AWS/Yandex) or "bunny".
# Set to bunny on the global origin; leave s3 on the RU proxy (→ Yandex).
LECTORIUM_STORAGE_BACKEND=s3

# ── storage-sync (Bunny -> Yandex mirror) ─────────────────────────────────
# Mirrors Bunny (source of truth) into the Yandex bucket for the Russia region.
# Runs on the origin role. Uses LECTORIUM_STORAGE_ZONE/KEY above.
# Yandex S3-compatible credentials (the same pair the RU proxy uses to write).
LECTORIUM_YC_ACCESS_KEY_ID=
LECTORIUM_YC_SECRET_ACCESS_KEY=
# LECTORIUM_YANDEX_ENDPOINT=https://storage.yandexcloud.net
# LECTORIUM_YANDEX_REGION=ru-central1
# Sync cadence + scope. INTERVAL in seconds (0 = run once and exit).
# DELETE=true prunes Yandex objects no longer present on Bunny.
# PREFIX empty = whole bucket (public/ + private/). Set e.g. public/ to scope.
LECTORIUM_STORAGE_SYNC_INTERVAL=3600
LECTORIUM_STORAGE_SYNC_PREFIX=
LECTORIUM_STORAGE_SYNC_CONCURRENCY=16
LECTORIUM_STORAGE_SYNC_DELETE=false

# ── share-video render config ───────────────────────────────────────
# Whisper API key — Whisper is the default transcriber. Use an OpenAI
# spending-cap key (set monthly limit in the OpenAI dashboard) — see
# infra/README.md.
LECTORIUM_OPENAI_API_KEY=
# whisper | speechkit. Leave whisper unless you've configured SpeechKit
# credentials in the env (SPEECHKIT_API_KEY etc.).
LECTORIUM_TRANSCRIBER=whisper

# ── Chat LLM model overrides ────────────────────────────────────────
# Pick larger-context models — synthesizer can assemble 30k+ tokens of
# retrieved context per research turn. Code defaults (deepseek-chat,
# 32k ctx) reject those with 400 BadRequest, which kills the SSE
# stream and surfaces as "chat error, try again later" on the client.
# Gemini flash-lite has a 1M window and is the cheapest model that
# absorbs our context shape.
LLM_DEFAULT=openrouter/google/gemini-3.1-flash-lite
LLM_FALLBACK=openrouter/anthropic/claude-3-haiku

# ── Local-dev host ports (docker-compose.dev.yml only) ──────────────
# Host-side port mappings for the local stack. They live in lectorium's
# reserved 11xxx band (workspace port convention — one thousands-block per
# project, lectorium = 11000-11999; see dotfiles personal/projects/
# jiva-studio/lectorium.nix) so a sibling project's local stack can't
# collide on a generic port. Container ports are unchanged; only the host
# side is remapped. Defaults below are baked into the compose overlay —
# override only if something else on the host already owns one.
#   11000 = docs   11001 = app dev server   111xx = worktree dev servers
# The mobile app's dev region defaults to chat 11080 / auth 11081; if you
# change these, also set VITE_DEV_CHAT_URL / VITE_DEV_AUTH_URL when serving.
# LECTORIUM_CHAT_PORT=11080
# LECTORIUM_AUTH_PORT=11081
# LECTORIUM_PG_PORT=11082
# LECTORIUM_REDIS_PORT=11083
# LECTORIUM_STREAMS_REDIS_PORT=11087
# LECTORIUM_SHARE_TRANSCRIPT_PORT=11085
# LECTORIUM_ORCHESTRATOR_PORT=11088
