# Caddy edge config for lectorium.
#
# - Auto-acquires Let's Encrypt cert via HTTP-01 for $DOMAIN.
#   For sslip.io: <ip-dashed>.sslip.io resolves to this server.
# - rate_limit is the mholt/caddy-ratelimit plugin (compiled in by
#   infra/compose/caddy/Dockerfile). One server-level directive with
#   per-path matchers — zones share the same in-memory bucket store.
# - handle_path strips the matched prefix before reverse_proxy so each
#   service sees its own internal paths (`/excerpts`, `/reels`, `/auth/...`).
# - request_body limits cap PUT/POST payload size at the edge.
#
# DUAL-ROLE: this server file is shared between two deployment shapes,
# selected at container start by LECTORIUM_REGION_ROLE:
#   - origin (global) → imports role-origin.conf
#                       (terminates /auth/* + /chat locally)
#   - proxy  (RU)     → imports role-proxy.conf
#                       (reverse-proxies /auth/* + /chat to global host;
#                        only /share/* terminates locally)
# Both snippets are baked into the lectorium-caddy image alongside this
# Caddyfile (see infra/app/compose/caddy/Dockerfile).

{
    email {$ACME_EMAIL}

    log {
        output stderr
        level WARN
    }

    # Every rate-limit zone below keys on {client_ip}. Without a trusted
    # proxy list Caddy falls back to {remote_ip}, so on the origin EVERY
    # RU-forwarded request keys by the single public IP of the RU box:
    # one RU user typing in search could exhaust the `discovery` budget
    # for all RU users, and the same for chat and anonymous sign-up.
    # Trusting the RU egress IP makes {client_ip} resolve to the real
    # client from the X-Forwarded-For that reverse_proxy already sets.
    #
    # Two defaults on purpose, because the two halves of this change reach
    # a host by different routes and in no guaranteed order: the Caddyfile
    # rides the image and Watchtower rolls it unattended, while compose
    # arrives by rsync from deploy.sh. So this file must parse against a
    # compose that has never heard of LECTORIUM_TRUSTED_PROXIES.
    #
    #   - `:127.0.0.1/32` here covers the var being UNSET (old compose).
    #   - compose's own `:-` covers it being present-but-empty, which Caddy
    #     would otherwise treat as a value.
    #
    # Either way an empty argument — which is a parse error that stops the
    # edge from starting — is impossible, and the fallback trusts nothing
    # real, which is correct when there is no edge in front.
    servers {
        trusted_proxies static {$LECTORIUM_TRUSTED_PROXIES:127.0.0.1/32}
    }
}

# Both role snippets are defined here at global scope; only the one
# named by LECTORIUM_REGION_ROLE is *invoked* inside the route block
# below. Defining the unused one is free — snippet defs don't execute.
import role-origin.conf
import role-proxy.conf

{$DOMAIN} {
    # No `encode` — /chat is SSE (zstd/gzip buffers byte-frames before
    # flushing, which breaks per-event streaming and was felt as
    # noticeable lag in the mobile chat UI). /auth and /share/* return
    # short JSON bodies (<1KB) where compression saves nothing useful.

    # Baseline browser security headers. Applied to every response.
    # HSTS: TLS-only once seen; X-Frame-Options blocks clickjacking;
    # X-Content-Type-Options blocks MIME sniffing; Referrer-Policy
    # keeps URLs from leaking on cross-origin navigations.
    # We don't serve a web UI, so CSP isn't worth the maintenance cost.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Hide Caddy version in errors.
        -Server
        # CORS — Capacitor mobile WebView lives at capacitor://localhost,
        # ionic://localhost, http://localhost (per platform), so it
        # cross-origins everything. Allow * for headers we accept and the
        # methods our backends serve. share-audio's FastAPI used to add
        # these itself; auth (Go) and the share-video Express server
        # don't, so put them on the edge once and for all.
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Chat-Protocol-Version, X-Request-Id, Idempotency-Key, X-Trace-Id, X-Device-Id, Accept"
        Access-Control-Max-Age "600"
    }

    # Per-IP rate limits. Each zone has its own matcher; a request that
    # matches multiple zones (shouldn't happen with our path partitioning)
    # would be tested against all of them. Zones fire on the path the
    # client requested, regardless of whether the handler terminates
    # locally (origin) or reverse-proxies upstream (proxy) — so RU's edge
    # cap still bounds /chat traffic before forwarding to global.
    rate_limit {
        # /auth/anonymous — cheap to mint; botnet burst-fence, not a usage cap.
        zone auth_anonymous {
            match {
                path /auth/anonymous
            }
            key {client_ip}
            events 120
            window 1m
        }
        # /auth/signin/* — brute-force defence. A legit signin happens 1-2
        # times in a user's lifetime; bot attempts come in bursts.
        zone auth_signin {
            match {
                path /auth/signin/*
            }
            key {client_ip}
            events 20
            window 1m
        }
        # /share/audio/* — cheap stream-copy (<1s each), keep loose for
        # CGNAT-shared IPs. Idempotent on excerpt_id so retries are free.
        zone share_audio {
            match {
                path /share/audio/*
            }
            key {client_ip}
            events 60
            window 1m
        }
        # /share/video/* — expensive (~30-90s render + Whisper API). 20/hour
        # is plenty for a CGNAT IP; further per-user caps land in P6.5.
        zone share_video {
            match {
                path /share/video/*
            }
            key {client_ip}
            events 20
            window 1h
        }
        # /share/transcripts/* — PDF render (~0.1-0.5s, or a few s on a cold TOC
        # LLM call). Idempotent + CDN-cached, so keep it loose like audio.
        zone share_transcript {
            match {
                path /share/transcripts/*
            }
            key {client_ip}
            events 60
            window 1m
        }
        # /profile/* — device↔server sync (push/pull change batches).
        # Cheap JSON, not the LLM cost surface, so keep it generous: a
        # sync-heavy client (multiple devices on a CGNAT-shared IP) can
        # burst freely; this only fences a pathological flood.
        zone profile {
            match {
                path /profile/*
            }
            key {client_ip}
            events 300
            window 1m
        }
        # /analytics/* — public read-only reports for the marketing site's
        # live counter. Cheap cached JSON; keep generous so a CGNAT-shared
        # IP loading the homepage repeatedly isn't fenced. Dedicated zone so
        # it doesn't count against the chat DoS cap below.
        zone analytics {
            match {
                path /analytics/*
            }
            key {client_ip}
            events 300
            window 1m
        }
        # /discovery/search — the search field on the library tab, which
        # queries as the user types. Its own zone because the catch-all below
        # is sized for whole conversations and this is sized for keystrokes:
        # one pause in typing is one request, so an ordinary minute of
        # searching is tens of them, and counted against the chat cap a few
        # people behind one CGNAT address would fence the lot. Typing costs an
        # embedding and no model — the model runs only when the magnifier is
        # tapped, which a person does deliberately and rarely.
        zone discovery {
            match {
                path /discovery/search
            }
            key {client_ip}
            events 300
            window 1m
        }
        # /chat/* root — main LLM cost surface. Loose DoS shield: this
        # cap is for catching obvious botnet-scale abuse from one IP,
        # not for governing legitimate user behaviour. The 200/h cap we
        # used to have here clipped CGNAT peers (Yota / Tele2 / Beeline
        # mobile, corporate offices, ashrams) — ~10 active Pro users
        # on one shared IP collectively hit 200/h well before any of
        # them dented their personal 200/day, and the bare-Caddy 429 has
        # no JSON envelope so the mobile UI couldn't differentiate an
        # ip-cap clip from a user-cap clip.
        #
        # The real auth-aware policing lives in the chat service's
        # rate_limiter (per-user 200/day Pro, plus a per-IP cap that
        # only applies to anonymous JWTs). Edge stays a dumb fence.
        zone chat {
            match {
                # Negative match so this fires on the root catch-all but
                # NOT on /auth/*, /share/*, /profile/*, /orchestrator/* or
                # /discovery/search.
                # Order matters: more specific zones above were already checked.
                not {
                    path /auth/* /share/* /profile/* /orchestrator/* /analytics/* /discovery/search
                }
            }
            key {client_ip}
            events 1000
            window 1h
        }
    }

    # Routes wrapped in a `route` block so they execute in DECLARATION
    # order, not Caddy's standard directive order. We need this for two
    # reasons:
    #   1. CORS preflight short-circuit (OPTIONS → 204) must run BEFORE
    #      the path-matched handles. Otherwise `handle /auth/*` claims
    #      the request and the upstream Go service returns 405 — browser
    #      cancels the actual POST and the request never lands. The
    #      CORS headers themselves are set in the global header{} block
    #      above (`deferred` mode), so the 204 already carries them.
    #   2. Without `route`, two `handle` blocks without a path matcher
    #      (the OPTIONS one and the chat catch-all) collide and Caddy
    #      silently drops one.
    route {
        @options method OPTIONS
        respond @options 204

        # ── /share/audio/* — share-audio service ───────────────────
        # Same on both roles: terminates locally so the resulting S3 URL
        # belongs to the regional bucket (RU → Yandex S3, global → AWS).
        # handle_path strips the prefix so the FastAPI app sees /excerpts.
        # Body cap is generous for a JSON envelope (<1KB in practice) but
        # forbids someone POSTing a multi-MB blob to chew worker memory.
        # X-Lectorium-Region strip mirrors role-origin.conf's policy on
        # chat/auth: only the trusted proxy may set the header on egress,
        # so any inbound value reaching share-* here is forged and dropped.
        # Low-impact today (share-* don't read it) but keeps the invariant.
        handle_path /share/audio/* {
            request_header -X-Lectorium-Region
            request_body {
                max_size 100KB
            }
            reverse_proxy share-audio:8082
        }

        # ── /share/video/* — share-video service ───────────────────
        handle_path /share/video/* {
            request_header -X-Lectorium-Region
            request_body {
                max_size 100KB
            }
            reverse_proxy share-video:8083 {
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # ── /share/transcripts/* — share-transcript service ───────────────────────
        # Terminates locally on every region so the returned PDF URL
        # belongs to the regional bucket. handle_path strips the prefix so
        # the FastAPI app sees /pdf. Header timeout covers a cold TOC LLM.
        handle_path /share/transcripts/* {
            request_header -X-Lectorium-Region
            request_body {
                max_size 100KB
            }
            reverse_proxy share-transcript:8084 {
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # ── Role-specific handlers ─────────────────────────────────
        # origin → role-origin.conf (terminates /auth/* + chat locally
        #          and strips inbound X-Lectorium-Region so only trusted
        #          proxy egress can set it).
        # proxy  → role-proxy.conf  (reverse-proxies same paths upstream
        #          to {$LECTORIUM_GLOBAL_HOST} with X-Lectorium-Region: ru).
        import role-{$LECTORIUM_REGION_ROLE}
    }

    # Re-apply CORS on errors — the global header{} runs inside the route
    # chain, so rate_limit 429s short-circuit without it and read as CORS
    # failures in the WebView instead of a legible 429.
    handle_errors {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, POST, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-Chat-Protocol-Version, X-Request-Id, Idempotency-Key, X-Trace-Id, X-Device-Id, Accept"
            Access-Control-Expose-Headers "Retry-After, X-Request-Id"
        }
        respond {err.status_code}
    }

    log {
        output stdout
        format json
    }
}

# ── Website (static) ──────────────────────────────────────────────
# Serves the prebuilt Astro site — rsync'd to /opt/lectorium/web on the
# host, bind-mounted to /srv/web. Pure file_server: no app, no SSR, no
# per-request render. All pages are prebuilt by `astro build`.
#
# Origin-only. LECTORIUM_WEB_DOMAIN is the public hostname there (an
# <ip-dashed>.sslip.io for first tests, the real domain later); Caddy
# auto-issues Let's Encrypt for it via HTTP-01. On hosts that don't
# serve the site (RU proxy, or before the var is set) it defaults to
# ":8088" — an internal HTTP-only port nobody maps — so the block parses
# and binds harmlessly without attempting ACME for a real name.
{$LECTORIUM_WEB_DOMAIN::8088} {
    encode gzip zstd
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    # Language negotiation on the bare entry path only. /en/ and /ru/ stay
    # the canonical, indexable URLs; this just picks one for a "/" visit,
    # by the browser's Accept-Language primary tag (ru* → /ru/, else /en/).
    # Vary so any cache keys the redirect per language. Deep links
    # (/en/..., /ru/...) are served directly below, untouched.
    @root path /
    handle @root {
        header Vary Accept-Language
        @ru header Accept-Language ru*
        redir @ru /ru/ 302
        redir * /en/ 302
    }
    handle {
        root * /srv/web
        # Astro emits pretty URLs as <path>/index.html; serve them without
        # a trailing-slash redirect.
        try_files {path} {path}/index.html {path}.html
        file_server
    }
}

# ── Public MCP endpoint (corpus-mcp) ──────────────────────────────
# Its OWN subdomain, serving the standard MCP paths at the host root:
# streamable-HTTP /mcp, SSE /sse, /healthz. A subdomain (not a path
# prefix on {$DOMAIN}) because public MCP clients / claude.ai connectors
# expect /mcp at the root — no prefix-strip, no coupling to the app API.
# Read-only + no-auth, so the edge is the only guardrail: per-IP rate
# limit (each search/*.resolve spends one embedding call) + a body cap +
# permissive CORS for browser connectors.
# Origin-only. Defaults to internal ":8089" when LECTORIUM_MCP_DOMAIN is
# unset (RU proxy / pre-config) so the block parses and binds harmlessly
# without attempting ACME for a real name — same pattern as the web block.
{$LECTORIUM_MCP_DOMAIN::8089} {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        # Permissive CORS — read-only public data; lets a browser MCP
        # client (e.g. a claude.ai custom connector) reach it.
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE"
        Access-Control-Allow-Headers "Content-Type, Authorization, Accept, Mcp-Session-Id, MCP-Protocol-Version, Last-Event-ID"
        Access-Control-Expose-Headers "Mcp-Session-Id"
        Access-Control-Max-Age "600"
    }

    # Per-IP edge fence against a single pathological flood. Deliberately
    # GENEROUS, not a usage cap: a hosted MCP connector (claude.ai, etc.) sends
    # ALL of its users' traffic from a small set of the vendor's egress IPs, so
    # they share ONE bucket here — a tight per-IP cap would throttle the whole
    # connector user-base, not protect anything. Real backend/cost control lives
    # downstream and sheds gracefully instead of 429-ing legit users: the
    # corpus-mcp pgxpool (≈10 concurrent searches) queues excess, the Redis
    # embed cache kills repeat-query cost, and each tool has a hard result cap.
    # Browse/read calls are cheap in-process SQLite; only `search` is costly and
    # is already bounded by the pool. If a genuine per-user limit is ever needed
    # it belongs in the service (keyed by the request client_hash), not here.
    rate_limit {
        zone mcp {
            key {client_ip}
            events 1200
            window 1m
        }
    }

    route {
        # CORS preflight short-circuit before the proxy claims the request.
        @options method OPTIONS
        respond @options 204

        request_body {
            max_size 64KB
        }
        # No prefix strip: the service already serves /mcp, /sse, /healthz
        # at root. flush_interval -1 streams SSE events as they arrive.
        reverse_proxy corpus-mcp:8087 {
            flush_interval -1
        }
    }

    handle_errors {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE"
            Access-Control-Allow-Headers "Content-Type, Authorization, Accept, Mcp-Session-Id, MCP-Protocol-Version, Last-Event-ID"
        }
        respond {err.status_code}
    }

    log {
        output stdout
        # Anonymise the client IP in access logs: the public MCP is read-only and
        # has no accounts, so we keep only a coarse network prefix (/24 · /48) and
        # never retain a raw IP. Rate-limiting still keys on the full {client_ip};
        # only the logged value is masked.
        format filter {
            wrap json
            request>client_ip ip_mask {
                ipv4 24
                ipv6 48
            }
            request>remote_ip ip_mask {
                ipv4 24
                ipv6 48
            }
        }
    }
}
