# Caddy edge config for shruti.
#
# - Auto-acquires Let's Encrypt cert via HTTP-01 for $DOMAIN.
#   For sslip.io: <ip-dashed>.sslip.io resolves to this server.
# - rate_limit is the mholt/caddy-ratelimit plugin (compiled in by
#   infra/compose/caddy/Dockerfile). One server-level directive with
#   per-path matchers — zones share the same in-memory bucket store.
# - handle_path strips the matched prefix before reverse_proxy so each
#   service sees its own internal paths (`/excerpts`, `/reels`, `/auth/...`).
# - request_body limits cap PUT/POST payload size at the edge.
#
# DUAL-ROLE: this server file is shared between two deployment shapes,
# selected at container start by SHRUTI_REGION_ROLE:
#   - origin (global) → imports role-origin.conf
#                       (terminates /auth/* + /chat locally)
#   - proxy  (RU)     → imports role-proxy.conf
#                       (reverse-proxies /auth/* + /chat to global host;
#                        only /share/* terminates locally)
# Both snippets are baked into the shruti-caddy image alongside this
# Caddyfile (see infra/app/compose/caddy/Dockerfile).

{
    email {$ACME_EMAIL}

    log {
        output stderr
        level WARN
    }
}

# Both role snippets are defined here at global scope; only the one
# named by SHRUTI_REGION_ROLE is *invoked* inside the route block
# below. Defining the unused one is free — snippet defs don't execute.
import role-origin.conf
import role-proxy.conf

{$DOMAIN} {
    # No `encode` — /chat is SSE (zstd/gzip buffers byte-frames before
    # flushing, which breaks per-event streaming and was felt as
    # noticeable lag in the mobile chat UI). /auth and /share/* return
    # short JSON bodies (<1KB) where compression saves nothing useful.

    # Baseline browser security headers. Applied to every response.
    # HSTS: TLS-only once seen; X-Frame-Options blocks clickjacking;
    # X-Content-Type-Options blocks MIME sniffing; Referrer-Policy
    # keeps URLs from leaking on cross-origin navigations.
    # We don't serve a web UI, so CSP isn't worth the maintenance cost.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Hide Caddy version in errors.
        -Server
        # CORS — Capacitor mobile WebView lives at capacitor://localhost,
        # ionic://localhost, http://localhost (per platform), so it
        # cross-origins everything. Allow * for headers we accept and the
        # methods our backends serve. share-audio's FastAPI used to add
        # these itself; auth (Go) and the share-video Express server
        # don't, so put them on the edge once and for all.
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Chat-Protocol-Version, X-Request-Id, Idempotency-Key, X-Trace-Id, Accept"
        Access-Control-Max-Age "600"
        Access-Control-Expose-Headers "Retry-After, X-Request-Id"
    }

    # Per-IP rate limits. Each zone has its own matcher; a request that
    # matches multiple zones (shouldn't happen with our path partitioning)
    # would be tested against all of them. Zones fire on the path the
    # client requested, regardless of whether the handler terminates
    # locally (origin) or reverse-proxies upstream (proxy) — so RU's edge
    # cap still bounds /chat traffic before forwarding to global.
    rate_limit {
        # /auth/anonymous — cheap to mint; botnet burst-fence, not a usage cap.
        zone auth_anonymous {
            match {
                path /auth/anonymous
            }
            key {client_ip}
            events 120
            window 1m
        }
        # /auth/signin/* — brute-force defence. A legit signin happens 1-2
        # times in a user's lifetime; bot attempts come in bursts.
        zone auth_signin {
            match {
                path /auth/signin/*
            }
            key {client_ip}
            events 20
            window 1m
        }
        # /share/audio/* — cheap stream-copy (<1s each), keep loose for
        # CGNAT-shared IPs. Idempotent on excerpt_id so retries are free.
        zone share_audio {
            match {
                path /share/audio/*
            }
            key {client_ip}
            events 60
            window 1m
        }
        # /share/video/* — expensive (~30-90s render + Whisper API). 20/hour
        # is plenty for a CGNAT IP; further per-user caps land in P6.5.
        zone share_video {
            match {
                path /share/video/*
            }
            key {client_ip}
            events 20
            window 1h
        }
        # /share/transcripts/* — PDF render (~0.1-0.5s, or a few s on a cold TOC
        # LLM call). Idempotent + CDN-cached, so keep it loose like audio.
        zone share_transcript {
            match {
                path /share/transcripts/*
            }
            key {client_ip}
            events 60
            window 1m
        }
        # /chat/* root — main LLM cost surface. Loose DoS shield: this
        # cap is for catching obvious botnet-scale abuse from one IP,
        # not for governing legitimate user behaviour. The 200/h cap we
        # used to have here clipped CGNAT peers (Yota / Tele2 / Beeline
        # mobile, corporate offices, ashrams) — ~10 active Pro users
        # on one shared IP collectively hit 200/h well before any of
        # them dented their personal 200/day, and the bare-Caddy 429 has
        # no JSON envelope so the mobile UI couldn't differentiate an
        # ip-cap clip from a user-cap clip.
        #
        # The real auth-aware policing lives in the chat service's
        # rate_limiter (per-user 200/day Pro, plus a per-IP cap that
        # only applies to anonymous JWTs). Edge stays a dumb fence.
        zone chat {
            match {
                # Negative match so this fires on the root catch-all but
                # NOT on /auth/* or /share/*. Order matters: more specific
                # zones above were already checked.
                not {
                    path /auth/* /share/*
                }
            }
            key {client_ip}
            events 1000
            window 1h
        }
    }

    # Routes wrapped in a `route` block so they execute in DECLARATION
    # order, not Caddy's standard directive order. We need this for two
    # reasons:
    #   1. CORS preflight short-circuit (OPTIONS → 204) must run BEFORE
    #      the path-matched handles. Otherwise `handle /auth/*` claims
    #      the request and the upstream Go service returns 405 — browser
    #      cancels the actual POST and the request never lands. The
    #      CORS headers themselves are set in the global header{} block
    #      above (`deferred` mode), so the 204 already carries them.
    #   2. Without `route`, two `handle` blocks without a path matcher
    #      (the OPTIONS one and the chat catch-all) collide and Caddy
    #      silently drops one.
    route {
        @options method OPTIONS
        respond @options 204

        # ── /share/audio/* — share-audio service ───────────────────
        # Same on both roles: terminates locally so the resulting S3 URL
        # belongs to the regional bucket (RU → Yandex S3, global → AWS).
        # handle_path strips the prefix so the FastAPI app sees /excerpts.
        # Body cap is generous for a JSON envelope (<1KB in practice) but
        # forbids someone POSTing a multi-MB blob to chew worker memory.
        # X-Shruti-Region strip mirrors role-origin.conf's policy on
        # chat/auth: only the trusted proxy may set the header on egress,
        # so any inbound value reaching share-* here is forged and dropped.
        # Low-impact today (share-* don't read it) but keeps the invariant.
        handle_path /share/audio/* {
            request_header -X-Shruti-Region
            request_body {
                max_size 100KB
            }
            reverse_proxy share-audio:8082
        }

        # ── /share/video/* — share-video service ───────────────────
        handle_path /share/video/* {
            request_header -X-Shruti-Region
            request_body {
                max_size 100KB
            }
            reverse_proxy share-video:8083 {
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # ── /share/transcripts/* — share-transcript service ───────────────────────
        # Terminates locally on every region so the returned PDF URL
        # belongs to the regional bucket. handle_path strips the prefix so
        # the FastAPI app sees /pdf. Header timeout covers a cold TOC LLM.
        handle_path /share/transcripts/* {
            request_header -X-Shruti-Region
            request_body {
                max_size 100KB
            }
            reverse_proxy share-transcript:8084 {
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # ── Role-specific handlers ─────────────────────────────────
        # origin → role-origin.conf (terminates /auth/* + chat locally
        #          and strips inbound X-Shruti-Region so only trusted
        #          proxy egress can set it).
        # proxy  → role-proxy.conf  (reverse-proxies same paths upstream
        #          to {$SHRUTI_GLOBAL_HOST} with X-Shruti-Region: ru).
        import role-{$SHRUTI_REGION_ROLE}
    }

    # Re-apply CORS on errors — the global header{} runs inside the route
    # chain, so rate_limit 429s short-circuit without it and read as CORS
    # failures in the WebView instead of a legible 429.
    handle_errors {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, POST, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-Chat-Protocol-Version, X-Request-Id, Idempotency-Key, X-Trace-Id, Accept"
            Access-Control-Expose-Headers "Retry-After, X-Request-Id"
        }
        respond {err.status_code}
    }

    log {
        output stdout
        format json
    }
}

# ── Website (static) ──────────────────────────────────────────────
# Serves the prebuilt Astro site — rsync'd to /opt/shruti/web on the
# host, bind-mounted to /srv/web. Pure file_server: no app, no SSR, no
# per-request render. All pages are prebuilt by `astro build`.
#
# Origin-only. SHRUTI_WEB_DOMAIN is the public hostname there (an
# <ip-dashed>.sslip.io for first tests, the real domain later); Caddy
# auto-issues Let's Encrypt for it via HTTP-01. On hosts that don't
# serve the site (RU proxy, or before the var is set) it defaults to
# ":8088" — an internal HTTP-only port nobody maps — so the block parses
# and binds harmlessly without attempting ACME for a real name.
{$SHRUTI_WEB_DOMAIN} {
    encode gzip zstd
    root * /srv/web
    # Astro emits pretty URLs as <path>/index.html; serve them without a
    # trailing-slash redirect.
    try_files {path} {path}/index.html {path}.html
    file_server
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
