# Local + production env files contain POSTGRES_PASSWORD and any provider
# secrets. Generated by infra/scripts/gen-dev-env.sh (dev) or by deploy.sh
# on the target VPS (prod). Never committed.
.env
.env.dev
.env.*.local

# JWT signing keys never enter git — only public halves under
# infra/app/jwt-keys/. See infra/app/jwt-keys/README.md for the
# trust model and rotation runbook.
*.priv.pem
*.key
