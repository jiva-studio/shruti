#!/usr/bin/env bash
set -euo pipefail

# Mutation testing: change the code on purpose and see whether the suite notices.
#
#   diff [package]   mutate only the source lines this branch added or changed,
#                    measured against the merge base with main. This is the
#                    per-change run, and what a band has to pass before
#                    handing over.
#
#   full [package]   mutate the whole package. Slow — hours, for a package the
#                    size of the mobile app — so it belongs on a schedule or a manual
#                    run, not in the gate.
#
# Both modes read the package's stryker.config.json and run Stryker in place from
# modules/, so the libraries are real files under the run directory: Stryker
# does not follow the app's submodules/ symlinks, and a sandbox copy cannot
# reach paths outside the app. The config's paths are relative to modules/.
# Stryker restores every file it instrumented when the run ends.
#
# Both modes run incrementally:
# results carry over in .stryker/incremental/, which is local and untracked, so
# a second run on the same checkout re-measures only what changed since the
# first. A file whose mutants are all restored is not re-run — which is what
# makes `full` bearable but is no substitute for `diff`, which hands Stryker
# only the changed line ranges.
#
# Coverage tells you a line executed. This tells you the suite would have
# complained if the line were wrong, which is the thing coverage never proves.

usage() {
  echo "usage: $(basename "$0") <diff|full> [package]" >&2
  exit 2
}

MODE="${1:-}"
[ -n "$MODE" ] || usage

PKG="${2:-mobile}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# `@task` is the active band task's target (a band pipeline's mutation stage).
# The mobile app compiles the TypeScript libs, so they are mutated through it;
# any other target has no Stryker config and is not applicable, not a failure.
if [ "$PKG" = "@task" ]; then
  PKG="$("$REPO_ROOT/scripts/band-task-target.sh")"
  case "$PKG" in
    modules/libs/pipeline*) ;;
    modules/libs/*) PKG=mobile ;;
  esac
  if [ ! -f "$REPO_ROOT/$PKG/stryker.config.json" ] && [ ! -f "$REPO_ROOT/modules/apps/$PKG/stryker.config.json" ]; then
    echo "$PKG has no stryker.config.json: mutation not applicable; hand-check each new test instead."
    exit 0
  fi
fi

# Resolve package directory
case "$PKG" in
  mobile|shruti-mobile|@shruti/mobile|modules/apps/mobile)
    PKG_DIR="$REPO_ROOT/modules/apps/mobile"
    PKG_NAME="shruti-mobile"
    ;;
  *)
    if [ -d "$REPO_ROOT/$PKG" ]; then
      PKG_DIR="$REPO_ROOT/$PKG"
      PKG_NAME="$(basename "$PKG")"
    elif [ -d "$REPO_ROOT/modules/$PKG" ]; then
      PKG_DIR="$REPO_ROOT/modules/$PKG"
      PKG_NAME="$(basename "$PKG")"
    else
      echo "unknown package: $PKG" >&2
      exit 1
    fi
    ;;
esac

if [ ! -f "$PKG_DIR/stryker.config.json" ]; then
  echo "$PKG_NAME has no stryker.config.json — it is not under mutation testing." >&2
  echo "Add one to $PKG_DIR to bring it in." >&2
  exit 1
fi

mkdir -p "$REPO_ROOT/.stryker/incremental"
CONFIG="$PKG_DIR/stryker.config.json"
STRYKER="$PKG_DIR/node_modules/.bin/stryker"
cd "$REPO_ROOT/modules"

case "$MODE" in
  full)
    exec "$STRYKER" run "$CONFIG"
    ;;
  diff)
    # MUTATE_BASE names another commit to measure against.
    BASE="${MUTATE_BASE:-$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || echo "HEAD~1")}"

    # Committed work plus whatever is still in the tree, so the run answers the
    # question before the last commit as well as after it. Each hunk's added
    # lines become a `path:start-end` range; a hunk that only deletes has
    # nothing to mutate. The config's mutate patterns select the files, as git
    # pathspecs: Stryker's own patterns do not apply to files named on the
    # command line.
    mapfile -t PATHSPECS < <(node -p 'require(process.argv[1]).mutate.map((p) => p.startsWith("!") ? ":(glob,exclude)" + p.slice(1) : ":(glob)" + p).join("\n")' "$CONFIG")
    RANGES=()
    while IFS= read -r line; do
      if [[ "$line" =~ ^\+\+\+\ (.*) ]]; then
        file="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^@@\ -[0-9,]+\ \+([0-9]+)(,([0-9]+))?\ @@ ]]; then
        start="${BASH_REMATCH[1]}"
        length="${BASH_REMATCH[3]:-1}"
        [ "$length" -eq 0 ] || RANGES+=("$file:$start-$((start + length - 1))")
      fi
    done < <(git diff -U0 --no-prefix --no-color --no-ext-diff --relative --diff-filter=d "$BASE" -- "${PATHSPECS[@]}")

    if [ "${#RANGES[@]}" -eq 0 ]; then
      echo "$PKG_NAME: no mutatable source lines added since $BASE. Nothing to measure."
      exit 0
    fi

    COUNT="$(printf '%s\n' "${RANGES[@]%:*}" | sort -u | wc -l)"
    echo "$PKG_NAME: mutating ${#RANGES[@]} changed line range(s) in $COUNT file(s) since $BASE"
    printf '  %s\n' "${RANGES[@]}"

    # Every file with a range must be instrumented, even when its ranges hold
    # nothing Stryker can mutate (comments, types): such a range yields no
    # mutants, not a missing file.
    LOG="$(mktemp)"
    trap 'rm -f "$LOG"' EXIT
    "$STRYKER" run "$CONFIG" --mutate "$(IFS=,; echo "${RANGES[*]}")" 2>&1 | tee "$LOG"
    if ! grep -q "Found $COUNT of [0-9]* file(s) to be mutated" "$LOG"; then
      echo "$PKG_NAME: Stryker did not instrument all $COUNT changed file(s)" >&2
      exit 1
    fi
    ;;
  *)
    usage
    ;;
esac
